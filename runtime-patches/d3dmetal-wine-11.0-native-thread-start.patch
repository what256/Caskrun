--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -1124,9 +1124,35 @@
  *
  * Startup routine for a newly created thread.
  */
+/* Original opt-in callback boundary. Wine's normal Unix transition supplies
+ * native stack/TSD state; no GS/TSD state is changed manually. Thread state
+ * stays in Wine's existing TEB storage, with no allocation for a suspended
+ * thread that is terminated before the callback starts. */
+NTSTATUS caskrun_d3dmetal_run_native_thread( void *args )
+{
+#if defined(__APPLE__) && defined(__x86_64__)
+    struct caskrun_native_thread_start_params *params = args;
+    struct ntdll_thread_data *thread_data = ntdll_get_thread_data();
+    typedef NTSTATUS (__attribute__((ms_abi)) *native_thread_start)(void *);
+
+    if (!params || !p__wine_caskrun_d3dmetal_thread_start ||
+        !caskrun_d3dmetal_is_selected_thread_start( thread_data->start ))
+        return STATUS_INVALID_PARAMETER;
+
+    /* Recheck the explicitly selected support image on the executing thread.
+     * Neither the PE argument nor the Unix-call payload can nominate a target. */
+    params->result = ((native_thread_start)thread_data->start)( thread_data->param );
+    return STATUS_SUCCESS;
+#else
+    (void)args;
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
 static void start_thread( TEB *teb )
 {
     struct ntdll_thread_data *thread_data = (struct ntdll_thread_data *)&teb->GdiTebBatch;
+    PRTL_THREAD_START_ROUTINE entry;
     BOOL suspend;
 
     thread_data->syscall_table = KeServiceDescriptorTable;
@@ -1134,7 +1160,19 @@
     thread_data->pthread_id = pthread_self();
     pthread_setspecific( teb_key, teb );
     server_init_thread( thread_data->start, &suspend );
-    signal_start_thread( thread_data->start, thread_data->param, suspend, teb );
+    entry = thread_data->start;
+#if defined(__APPLE__) && defined(__x86_64__)
+    if (caskrun_d3dmetal_is_selected_thread_start( entry ))
+    {
+        if (!p__wine_caskrun_d3dmetal_thread_start)
+        {
+            ERR( "Selected native thread has no matching Caskrun NTDLL PE relay\n" );
+            abort_thread( STATUS_ENTRYPOINT_NOT_FOUND );
+        }
+        entry = p__wine_caskrun_d3dmetal_thread_start;
+    }
+#endif
+    signal_start_thread( entry, thread_data->param, suspend, teb );
 }
 
 
