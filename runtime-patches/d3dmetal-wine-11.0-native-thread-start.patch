+#ifdef __x86_64__
+/***********************************************************************
+ * Original opt-in PE relay for a selected native Microsoft-ABI thread start.
+ * BaseThreadInitThunk and the normal Windows thread exit path stay unchanged.
+ */
+NTSTATUS WINAPI __wine_caskrun_d3dmetal_thread_start( void *arg )
+{
+    struct caskrun_native_thread_start_params params = { STATUS_UNSUCCESSFUL };
+    NTSTATUS status;
+
+    (void)arg;
+    status = WINE_UNIX_CALL( unix_caskrun_native_thread_start, &params );
+    return status ? status : params.result;
+}
+#endif
