+#include "prx/libc/include/WindowsMappings.hpp"
+#include <cstdint>
+#include <cstdio>
+#include <stdexcept>
+#include <system_error>
+
+namespace {
+int checks = 0;
+void Require(bool value, const char* message) {
+    ++checks;
+    if (!value) throw std::runtime_error(message);
+}
+
+MEMORY_BASIC_INFORMATION Query(const void* address) {
+    MEMORY_BASIC_INFORMATION info{};
+    if (VirtualQuery(address, &info, sizeof(info)) != sizeof(info))
+        throw std::system_error(GetLastError(), std::system_category(), "test query");
+    return info;
+}
+}
+
+int main() try {
+    constexpr std::size_t ReservationBytes = 0x10000;
+    constexpr std::size_t PageBytes = 0x4000;
+    auto& mappings = GuestArena::WindowsMappings::Get();
+    SYSTEM_INFO system{};
+    GetSystemInfo(&system);
+    Require(system.dwAllocationGranularity == ReservationBytes, "test requires 64KiB allocation granularity");
+
+    // Find a truly reservable run through the allocation API, then acquire its
+    // two halves separately. Every owned range below is an exact API success.
+    auto* base = static_cast<unsigned char*>(mappings.Reserve(nullptr, 2 * ReservationBytes));
+    Require(base != nullptr, "find contiguous placeholder run");
+    Require(VirtualFree(base, 0, MEM_RELEASE) != FALSE, "release initial locator reservation");
+    Require(mappings.Reserve(base, ReservationBytes) == base, "reserve first exact segment");
+    Require(mappings.Reserve(base + ReservationBytes, ReservationBytes) == base + ReservationBytes,
+            "reserve adjacent exact segment");
+    Require(Query(base).AllocationBase != Query(base + ReservationBytes).AllocationBase,
+            "test needs two original reservations");
+
+    auto* crossing = base + ReservationBytes - PageBytes;
+    const auto created = mappings.Commit(crossing, 2 * PageBytes, PAGE_READWRITE, 2 * PageBytes, true);
+    Require(created.size() == 1 && created.front().first == reinterpret_cast<std::uintptr_t>(crossing) &&
+            created.front().second == 2 * PageBytes, "private commit crosses the segment boundary");
+    crossing[0] = 0x39;
+    crossing[2 * PageBytes - 1] = 0x6a;
+    Require(crossing[0] == 0x39 && crossing[2 * PageBytes - 1] == 0x6a, "private memory is writable");
+    Require(Query(base).State == MEM_RESERVE && Query(crossing + 2 * PageBytes).State == MEM_RESERVE,
+            "neighbor placeholders survive private replacement");
+    mappings.Reset(crossing, 2 * PageBytes);
+    Require(Query(crossing).State == MEM_RESERVE && Query(crossing).RegionSize == 2 * PageBytes,
+            "private reset restores coalesced placeholder");
+
+    // Production PhysicalBacking creates an executable-capable section. Map
+    // first acquires a view with that maximum access, then narrows each guest
+    // page to the requested read/write protection.
+    HANDLE section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_EXECUTE_READWRITE, 0, ReservationBytes, nullptr);
+    Require(section != nullptr, "create shared backing section");
+    mappings.Map(crossing, 2 * PageBytes, section, 0, PAGE_READWRITE);
+    crossing[0] = 0x17;
+    crossing[PageBytes + 7] = 0x48;
+    auto* alias = static_cast<unsigned char*>(mappings.MapAlias(reinterpret_cast<std::uintptr_t>(crossing), 2 * PageBytes));
+    Require(alias != nullptr && alias[0] == 0x17 && alias[PageBytes + 7] == 0x48,
+            "two 16KiB shared pages are visible through their contiguous alias");
+    alias[PageBytes - 1] = 0x55;
+    alias[2 * PageBytes - 1] = 0x77;
+    Require(crossing[PageBytes - 1] == 0x55 && crossing[2 * PageBytes - 1] == 0x77,
+            "alias writes reach both guest pages");
+    mappings.UnmapAlias(alias);
+    mappings.Reset(crossing, 2 * PageBytes);
+    Require(Query(crossing).State == MEM_RESERVE && Query(crossing).RegionSize == 2 * PageBytes,
+            "shared reset unmaps both pages and coalesces their placeholders");
+    Require(CloseHandle(section) != FALSE, "close original shared backing handle");
+
+    mappings.Reset(base, 2 * ReservationBytes);
+    Require(Query(base).State == MEM_RESERVE && Query(base).RegionSize == 2 * ReservationBytes,
+            "whole run coalesces across both initial reservations");
+    Require(VirtualFree(base, 0, MEM_RELEASE) != FALSE, "release only the owned test run");
+    Require(Query(base).State == MEM_FREE, "test run leaves no reservation behind");
+    std::printf("%d Windows segmented mapping checks passed\n", checks);
+    return 0;
+} catch (const std::exception& error) {
+    std::fprintf(stderr, "Windows segmented mapping test failed: %s\n", error.what());
+    return 1;
+}
