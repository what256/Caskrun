+#include "prx/libc/include/ArenaReservation.hpp"
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+using namespace GuestArena::Reservation;
+constexpr std::uintptr_t Base = 0x200000000ull;
+constexpr std::size_t Granule = 0x10000;
+int checks = 0;
+
+void Require(bool value) {
+    ++checks;
+    if (!value) throw std::runtime_error("arena reservation regression");
+}
+
+void ValidateCoverage(const Layout& layout, std::uintptr_t first, std::uintptr_t last) {
+    auto all = layout.owned;
+    all.insert(all.end(), layout.excluded.begin(), layout.excluded.end());
+    std::sort(all.begin(), all.end());
+    auto next = first;
+    for (const auto& [start, end] : all) {
+        Require(start == next && end > start);
+        next = end;
+    }
+    Require(next == last);
+}
+
+Layout ConflictAt(std::size_t granules, std::vector<Range> conflicts, std::size_t budget = 4096) {
+    return Segmented(Base, Base + granules * Granule, Granule, budget,
+        [&](std::uintptr_t start, std::size_t bytes) {
+            return std::none_of(conflicts.begin(), conflicts.end(), [&](const auto& conflict) {
+                return conflict.first < start + bytes && start < conflict.second;
+            });
+        });
+}
+}
+
+int main() try {
+    auto free = ConflictAt(128, {});
+    Require(free.attempts == 1 && free.owned.size() == 1 && free.excluded.empty());
+    ValidateCoverage(free, Base, Base + 128 * Granule);
+
+    // This host interval is deliberately not visible to the hypothetical query.
+    auto hidden = ConflictAt(128, {{Base + 63 * Granule, Base + 64 * Granule}});
+    Require(hidden.owned.size() == 2 && hidden.excluded.size() == 1);
+    Require(hidden.excluded.front() == Range{Base + 63 * Granule, Base + 64 * Granule});
+    Require(Contains(hidden.owned, Base, 63 * Granule));
+    Require(!Contains(hidden.owned, Base + 63 * Granule, Granule));
+    Require(!Contains(hidden.owned, Base + 62 * Granule, 3 * Granule));
+    ValidateCoverage(hidden, Base, Base + 128 * Granule);
+
+    auto odd = ConflictAt(5, {{Base + 2 * Granule, Base + 3 * Granule}});
+    Require(odd.excluded.size() == 1 && odd.owned.size() == 2);
+    ValidateCoverage(odd, Base, Base + 5 * Granule);
+
+    auto none = ConflictAt(1024, {{Base, Base + 1024 * Granule}}, 9);
+    Require(none.attempts == 9 && none.owned.empty());
+    Require(none.excluded == std::vector<Range>{{Base, Base + 1024 * Granule}});
+    ValidateCoverage(none, Base, Base + 1024 * Granule);
+
+    // The unverified remainder is excluded when the budget ends; an accepted
+    // opposite half remains usable instead of being mislabeled as unowned.
+    auto bounded = ConflictAt(1024, {{Base, Base + 512 * Granule}}, 9);
+    Require(bounded.attempts == 9 && bounded.owned.size() == 1);
+    Require(bounded.owned.front() == Range{Base + 512 * Granule, Base + 1024 * Granule});
+    Require(!Contains(bounded.owned, Base, Granule));
+    Require(Contains(bounded.owned, Base + 512 * Granule, 512 * Granule));
+    ValidateCoverage(bounded, Base, Base + 1024 * Granule);
+
+    bool fatal = false;
+    try {
+        Segmented(Base, Base + Granule, Granule, 3,
+            [](std::uintptr_t, std::size_t) -> bool { throw std::runtime_error("unsupported API"); });
+    } catch (const std::runtime_error& error) { fatal = std::string(error.what()) == "unsupported API"; }
+    Require(fatal);
+    Require(!Contains(free.owned, std::numeric_limits<std::uintptr_t>::max() - 7, 16));
+    Require(!Contains(free.owned, Base + 128 * Granule, 0));
+
+    bool invalid = false;
+    try { Segmented(Base + 1, Base + Granule, Granule, 3, [](auto, auto) { return true; }); }
+    catch (const std::invalid_argument&) { invalid = true; }
+    Require(invalid);
+    std::cout << checks << " arena reservation checks passed\n";
+    return 0;
+} catch (const std::exception& error) {
+    std::cerr << error.what() << '\n';
+    return 1;
+}
