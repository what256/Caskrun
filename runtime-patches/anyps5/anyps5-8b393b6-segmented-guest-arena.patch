+#ifndef CORE_LIBS_PRX_LIBC_INCLUDE_ARENARESERVATION_HPP
+#define CORE_LIBS_PRX_LIBC_INCLUDE_ARENARESERVATION_HPP
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <iterator>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace GuestArena::Reservation {
+
+using Range = std::pair<std::uintptr_t, std::uintptr_t>;
+
+inline void MergeRanges(std::vector<Range>& ranges) {
+    std::sort(ranges.begin(), ranges.end());
+    std::size_t written = 0;
+    for (const auto range : ranges) {
+        if (range.first >= range.second) throw std::invalid_argument("invalid arena range");
+        if (written != 0 && ranges[written - 1].second >= range.first)
+            ranges[written - 1].second = std::max(ranges[written - 1].second, range.second);
+        else
+            ranges[written++] = range;
+    }
+    ranges.resize(written);
+}
+
+inline bool Contains(const std::vector<Range>& owned, std::uintptr_t address, std::size_t bytes) {
+    if (bytes > std::numeric_limits<std::uintptr_t>::max() - address) return false;
+    auto next = std::upper_bound(owned.begin(), owned.end(), address,
+        [](std::uintptr_t value, const Range& range) { return value < range.first; });
+    if (next == owned.begin()) return false;
+    const auto& range = *std::prev(next);
+    return address < range.second && bytes <= range.second - address;
+}
+
+struct Layout {
+    std::vector<Range> owned;
+    std::vector<Range> excluded;
+    std::size_t attempts = 0;
+};
+
+// The callback returns true only after reserving this exact range. False means
+// an address conflict; other failures must throw. A reported free interval may
+// contain native host mappings invisible to the Windows virtual-memory query.
+// Excluded intervals stay unowned even if they looked free in that query.
+template<class Reserve>
+Layout Segmented(std::uintptr_t first, std::uintptr_t last, std::size_t granularity,
+                 std::size_t attemptLimit, Reserve&& reserve) {
+    if (granularity == 0 || (granularity & (granularity - 1)) != 0 ||
+        first >= last || first % granularity != 0 || last % granularity != 0 ||
+        attemptLimit == 0)
+        throw std::invalid_argument("invalid segmented guest reservation");
+    Layout result;
+    std::deque<Range> pending{{first, last}};
+    // Breadth-first splitting probes both halves before spending the budget
+    // on a large conflicting native mapping near one end of the interval.
+    while (!pending.empty() && result.attempts < attemptLimit) {
+        const auto [start, end] = pending.front();
+        pending.pop_front();
+        ++result.attempts;
+        if (reserve(start, end - start)) {
+            result.owned.emplace_back(start, end);
+        } else if (end - start == granularity) {
+            result.excluded.emplace_back(start, end);
+        } else {
+            const auto middle = start + ((end - start) / granularity / 2) * granularity;
+            pending.emplace_back(start, middle);
+            pending.emplace_back(middle, end);
+        }
+    }
+    result.excluded.insert(result.excluded.end(), pending.begin(), pending.end());
+    MergeRanges(result.owned);
+    MergeRanges(result.excluded);
+    return result;
+}
+
+}
+
+#endif
