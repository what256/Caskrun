+#ifdef _WIN32
+static void CheckUnreservedArenaFixedMappingRefusal() {
+    constexpr std::size_t page = 0x4000;
+    std::uintptr_t base = 0;
+    std::size_t size = 0;
+    GuestArena::GuestArenaRange_nid_postfix(&base, &size);
+    auto* hole = reinterpret_cast<void*>(base);
+    if (GuestArena::GuestArenaContains_nid_postfix(hole, page)) {
+        std::puts("first arena page is owned; Wine native-hole rejection fixture is absent");
+        return;
+    }
+    const auto rejects = [&](const auto& operation) {
+        bool refused = false;
+        try { operation(); }
+        catch (const std::runtime_error& error) {
+            refused = std::string(error.what()).find("unreserved guest arena") != std::string::npos;
+        }
+        Require(refused);
+    };
+    MEMORY_BASIC_INFORMATION before{}, after{};
+    Require(VirtualQuery(hole, &before, sizeof(before)) == sizeof(before));
+    void* requested = hole;
+    rejects([&] { sceKernelMapFlexibleMemory(&requested, page, 3, 0x10); });
+    Require(requested == hole);
+    rejects([&] { sceKernelReserveVirtualRange(&requested, page, 0x10, 0); });
+    Require(requested == hole);
+    std::int64_t physical = 0;
+    Require(sceKernelAllocateDirectMemory(0, 0x7fffffffffll, page, 0, 0, &physical) == 0);
+    rejects([&] { sceKernelMapDirectMemory(&requested, page, 3, 0x10, physical, 0); });
+    Require(requested == hole);
+    Require(sceKernelReleaseDirectMemory(physical, page) == 0);
+    Require(VirtualQuery(hole, &after, sizeof(after)) == sizeof(after));
+    Require(before.BaseAddress == after.BaseAddress && before.AllocationBase == after.AllocationBase &&
+            before.RegionSize == after.RegionSize && before.State == after.State && before.Protect == after.Protect);
+
+    // A rejected fixed request spanning the hole and a live owned allocation
+    // must fail before fixed remapping can change that allocation.
+    void* owned = nullptr;
+    Require(sceKernelMapFlexibleMemory(&owned, page, 3, 0) == 0);
+    auto* bytes = static_cast<volatile unsigned char*>(owned);
+    bytes[0] = 0x42;
+    const auto ownedAddress = reinterpret_cast<std::uintptr_t>(owned);
+    Require(ownedAddress > base && ownedAddress - base < size);
+    requested = hole;
+    rejects([&] { sceKernelReserveVirtualRange(&requested, ownedAddress - base + page, 0x10, 0); });
+    Require(requested == hole && bytes[0] == 0x42);
+    Require(sceKernelMunmap(owned, page) == 0);
