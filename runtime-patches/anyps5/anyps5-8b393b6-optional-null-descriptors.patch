+void ValidateImageHeapElements(const Context& context, std::span<const CompiledShader> shaders) {
+    if (context.nullDescriptors) return;
+    for (const auto& shader : shaders) {
+        Require(shader.program != nullptr, "missing compiled shader");
+        for (const auto& binding : shader.program->bindings) {
+            if (binding.role == ShaderRecompiler::DescriptorRole::GuestImages && (binding.kind == ShaderRecompiler::DescriptorKind::SampledImage || binding.kind == ShaderRecompiler::DescriptorKind::StorageImage)) {
+                RequireImageHeapElements(false, binding.count, binding.guestDescriptor);
+            }
+        }
+    }
 }
 
