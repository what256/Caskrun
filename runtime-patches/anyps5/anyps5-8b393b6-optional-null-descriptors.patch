+// This is deliberately a refusal policy, not null-descriptor emulation. The same
+// base-address fields are used by ShaderResources to choose a Vulkan null view.
+inline void RequireImageHeapElements(bool nativeNullDescriptors, std::uint32_t count, std::span<const std::uint32_t> words) {
+    if (count == 0u || words.size() != static_cast<std::uint64_t>(count) * 8u) {
+        throw std::runtime_error("AGC graphics: guest image descriptors must contain eight DWORDs per array element");
+    }
+    if (nativeNullDescriptors) return;
+    for (std::uint32_t element = 0u; element < count; ++element) {
+        const auto offset = static_cast<std::size_t>(element) * 8u;
+        if (words[offset] == 0u && (words[offset + 1u] & 0xffu) == 0u) {
+            throw std::runtime_error("AGC graphics: image heap element " + std::to_string(element) + " requires nullDescriptor, which this device does not support");
+        }
+    }
+}
+
+}
+#endif
