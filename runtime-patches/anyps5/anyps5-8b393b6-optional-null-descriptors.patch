+void nonNullDescriptorResourcesTests() {
+    auto context = mockContext();
+    context.nullDescriptors = false;
+    const auto color = AgcDriver::Graphics::DecodeState(makeState()).color;
+    mock = MockVulkan{};
+    {
+        ShaderRecompiler::RecompileResult vertex;
+        ShaderRecompiler::RecompileResult fragment;
+        AgcDriver::Graphics::ShaderResources resources(context, vertex, fragment, color, 0, 0);
+        Require(mock.writes.empty(), "a no-image shader wrote a descriptor");
+        Require(resources.Reusable(), "the empty resource plan should be reusable");
+        auto nullImage = makeBinding(Role::GuestImages, 1u, 1u, std::vector<std::uint32_t>(8u));
+        nullImage.kind = Kind::SampledImage;
+        vertex.bindings.push_back(std::move(nullImage));
+        const std::array<AgcDriver::Graphics::CompiledShader, 2> changed{{{ShaderRecompiler::ShaderStage::Vertex, &vertex, 0}, {ShaderRecompiler::ShaderStage::Fragment, &fragment, 0}}};
+        expectFailure([&] { resources.ProveCurrent(changed); }, "requires nullDescriptor");
+        Require(mock.writes.empty(), "a refused cache proof wrote a descriptor");
+    }
+    Require(mock.live == 0, "a no-image shader leaked Vulkan objects without nullDescriptor");
+    for (const auto kind : {Kind::SampledImage, Kind::StorageImage}) {
+        for (const auto count : {1u, 2u}) {
+            mock = MockVulkan{};
+            ShaderRecompiler::RecompileResult vertex;
+            ShaderRecompiler::RecompileResult fragment;
+            // The first stage has a real buffer: the second stage's null must be
+            // refused before even this valid resource is allocated or uploaded.
+            vertex.bindings.push_back(makeBinding(Role::GuestBuffers, 0, 1, vsharp(guestThird.data(), 8)));
+            auto image = makeBinding(Role::GuestImages, kind == Kind::SampledImage ? 64u : 92u, count, std::vector<std::uint32_t>(count * 8u));
+            image.kind = kind;
+            if (count == 2u) image.guestDescriptor[0] = 1u;
+            fragment.bindings.push_back(std::move(image));
+            expectFailure([&] { AgcDriver::Graphics::ShaderResources resources(context, vertex, fragment, color, 0, 0); }, "requires nullDescriptor");
+            Require(mock.writes.empty() && mock.allocationAttempts == 0 && mock.live == 0, "a refused null image touched Vulkan resources");
+        }
+    }
+    for (const bool deferred : {false, true}) {
+        mock = MockVulkan{};
+        ShaderRecompiler::RecompileResult compute;
+        // A malformed address-table binding would ordinarily fail in preparation.
+        // Null preflight must win before that path reconciles or pins guest memory.
+        compute.bindings.push_back(makeBinding(Role::BdaPagetable, 59u, 1u, {}));
+        auto image = makeBinding(Role::GuestImages, 1u, 1u, std::vector<std::uint32_t>(8u));
+        image.kind = Kind::SampledImage;
+        compute.bindings.push_back(std::move(image));
+        const AgcDriver::Graphics::CompiledShader shader{ShaderRecompiler::ShaderStage::Compute, &compute, 0};
+        expectFailure([&] { AgcDriver::Graphics::ShaderResources resources(context, shader, {}, deferred); }, "requires nullDescriptor");
+        Require(mock.writes.empty() && mock.allocationAttempts == 0 && mock.live == 0, "a refused address-based null image touched Vulkan resources");
+    }
+}
