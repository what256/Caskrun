+/* Submits one explicit Quit. It stays in flight until Core's child is reaped. */
+static BOOL CaskrunSubmitSteamQuit(void)
+{
+    if (!CaskrunSpawnSteamControl(CASKRUN_STEAM_CONTROL_QUIT)) return NO;
+    caskrunSteamShutdownPending = YES;
+    caskrunSteamQuitGeneration++;
+    return YES;
+}
+
+static void CaskrunSteamControlFinished(enum caskrun_steam_control control, BOOL failed)
+{
+    unsigned long generation;
+
+    if (control == CASKRUN_STEAM_CONTROL_SHOW)
+    {
+        caskrunSteamShowPending = NO;
+        if (caskrunSteamQuitQueued)
+        {
+            /* The earlier show has completed and can no longer overtake the
+             * explicit Quit queued behind it. Submit that Quit exactly once. */
+            caskrunSteamQuitQueued = NO;
+            if (!CaskrunSubmitSteamQuit()) CaskrunSteamQuitFailed();
+        }
+        else if (failed) NSBeep();
+        return;
+    }
+    caskrunSteamShutdownPending = NO;
+    if (failed)
+    {
+        caskrunSteamQuitHeld = NO;
+        CaskrunSteamQuitFailed();
+        return;
+    }
+    /* Core's success proves submission, not that Steam exited. Hold Dock shows
+     * for five seconds after this child completed; only a timer of the same
+     * generation may end the hold, so it never unblocks a newer Quit. No timer
+     * cancels or signals a process. */
+    generation = caskrunSteamQuitGeneration;
+    caskrunSteamQuitHeld = YES;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        if (generation == caskrunSteamQuitGeneration) caskrunSteamQuitHeld = NO;
+    });
+}
+
+static BOOL CaskrunRequestSteamShutdown(void)
+{
+    if (caskrunSteamShutdownPending || caskrunSteamQuitQueued) return YES;
+    if (caskrunSteamShowPending)
+    {
+        /* Never submit Quit beside a show whose Core lock order may differ. */
+        caskrunSteamQuitQueued = YES;
+        return YES;
+    }
+    return CaskrunSubmitSteamQuit();
+}
+
+/* Returns whether a new show request was submitted. Pending, queued or
+ * recently submitted Quit suppresses it; a refused binding or spawn beeps. */
+static BOOL CaskrunRequestSteamShow(void)
+{
+    if (caskrunSteamShutdownPending || caskrunSteamQuitQueued || caskrunSteamQuitHeld ||
+        caskrunSteamShowPending) return NO;
+    if (!CaskrunSpawnSteamControl(CASKRUN_STEAM_CONTROL_SHOW))
+    {
+        NSBeep();
+        return NO;
+    }
+    caskrunSteamShowPending = YES;
     return YES;
 }
