+/* Appended Unix call 146 preserves every existing x64/WoW64 ordinal. */
+WINEMETAL_API void
+PrepareMetalView(obj_handle_t view) {
+  struct unixcall_generic_obj_noret params;
+  params.handle = view;
+  UNIX_CALL(146, &params);
+}
