+/* Original Caskrun Wine 11 host adapter. LGPL-2.1-or-later. */
+#ifndef __CASKRUN_D3DMETAL_MACDRV_H
+#define __CASKRUN_D3DMETAL_MACDRV_H
+
+enum d3dmetal_macdrv_operation
+{
+    D3DM_REG_QUERY,
+    D3DM_REG_SET,
+    D3DM_REG_OPEN,
+    D3DM_REG_CREATE,
+    D3DM_REG_CLOSE,
+    D3DM_ENUM_MONITORS,
+    D3DM_MONITOR_INFO,
+    D3DM_ADJUST_RECT,
+    D3DM_GET_WINDOW_LONG,
+    D3DM_GET_WINDOW_RECT,
+    D3DM_MOVE_WINDOW,
+    D3DM_SET_WINDOW_POS,
+    D3DM_GET_METRIC,
+    D3DM_SET_WINDOW_LONG,
+    D3DM_OPERATION_COUNT
+};
+
+/* Fixed-width transport, shared by the PE and Unix halves of this driver.
+ * All pointees belong to the calling process and are used synchronously. */
+struct d3dmetal_macdrv_request
+{
+    struct dispatch_callback_params dispatch;
+    UINT operation;
+    DWORD initial_error;
+    UINT64 args[9];
+};
+
+struct d3dmetal_macdrv_result
+{
+    UINT64 value;
+    DWORD last_error;
+    DWORD reserved;
+};
+
+/* Fixed-width synchronous PE/native callback transport, also valid under
+ * WoW64. Keep Wine's ordinary Unix transition responsible for GS/TSD/stack
+ * state rather than calling native code directly from a PE kernel callback. */
+struct d3dmetal_monitor_callback_params
+{
+    UINT64 callback;
+    UINT64 monitor;
+    UINT64 dc;
+    UINT64 rect;
+    UINT64 data;
+    DWORD result;
+    DWORD last_error;
+};
+C_ASSERT(sizeof(struct d3dmetal_monitor_callback_params) == 48);
+extern NTSTATUS d3dmetal_macdrv_enum_callback(void *arg);
+
+extern NTSTATUS WINAPI d3dmetal_macdrv_dispatch(void *arg, ULONG size);
+
+#endif
