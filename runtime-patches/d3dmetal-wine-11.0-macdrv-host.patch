+C_ASSERT(sizeof(struct d3dmetal_macdrv_functions) == 192);
+C_ASSERT(offsetof(struct d3dmetal_macdrv_functions, reg_query) == 80);
+C_ASSERT(offsetof(struct d3dmetal_macdrv_functions, set_window_long) == 184);
