+    LSTATUS (D3DM_MSABI *reg_query)(HKEY,LPCSTR,LPDWORD,LPDWORD,BYTE *,LPDWORD);
+    LSTATUS (D3DM_MSABI *reg_set)(HKEY,LPCSTR,DWORD,DWORD,const BYTE *,DWORD);
+    LSTATUS (D3DM_MSABI *reg_open)(HKEY,LPCSTR,DWORD,DWORD,HKEY *);
+    LSTATUS (D3DM_MSABI *reg_create)(HKEY,LPCSTR,DWORD,LPSTR,DWORD,DWORD,LPSECURITY_ATTRIBUTES,HKEY *,LPDWORD);
+    LSTATUS (D3DM_MSABI *reg_close)(HKEY);
+    BOOL (D3DM_MSABI *enum_monitors)(HDC,LPRECT,host_monitor_callback,LPARAM);
