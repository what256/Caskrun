+static void host_init_displays(BOOL force)
+{
+    /* Use Wine's normal display invalidation path when explicitly requested,
+     * then materialize its existing device list through a real USER32 query. */
+    if (force) NtUserCallNoParam(NtUserCallNoParam_DisplayModeChanged);
+    host_get_metric(SM_CMONITORS);
+}
