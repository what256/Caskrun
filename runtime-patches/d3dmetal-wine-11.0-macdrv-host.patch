+/* Original Caskrun Wine 11 host adapter. LGPL-2.1-or-later. */
+#include <stdarg.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "winuser.h"
+#include "unixlib.h"
+#include "d3dmetal-macdrv.h"
+
+#define PTR(type, n) ((type)(UINT_PTR)request->args[n])
+#define NUM(type, n) ((type)request->args[n])
+
+/* Kernel callback dispatch must always target Wine PE code. Native support
+ * callbacks use the published WINAPI signature and are invoked synchronously
+ * from this typed relay, preserving the original lparam and early-stop BOOL. */
+struct d3dmetal_monitor_context
+{
+    MONITORENUMPROC callback;
+    LPARAM data;
+};
+
+static BOOL CALLBACK d3dmetal_monitor_relay(HMONITOR monitor, HDC dc, LPRECT rect, LPARAM data)
+{
+    struct d3dmetal_monitor_context *context = (void *)data;
+    struct d3dmetal_monitor_callback_params params =
+    {
+        .callback = (UINT_PTR)context->callback, .monitor = (UINT_PTR)monitor,
+        .dc = (UINT_PTR)dc, .rect = (UINT_PTR)rect, .data = context->data,
+        .last_error = GetLastError()
+    };
+
+    if (MACDRV_CALL(d3dmetal_enum_callback, &params))
+    {
+        SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+        return FALSE;
+    }
+    SetLastError(params.last_error);
+    return params.result;
+}
+
+/* Keep Windows ANSI conversion, predefined HKEY handling, monitor callbacks,
+ * HWND validation and LastError semantics in Wine's actual PE APIs. The Unix
+ * half only adapts calling conventions; it does not emulate these APIs. */
+NTSTATUS WINAPI d3dmetal_macdrv_dispatch(void *arg, ULONG size)
+{
+    const struct d3dmetal_macdrv_request *request = arg;
+    struct d3dmetal_macdrv_result result = {0};
+
+    if (size != sizeof(*request) || request->operation >= D3DM_OPERATION_COUNT)
+        return NtCallbackReturn(NULL, 0, STATUS_INVALID_PARAMETER);
+
+    SetLastError(request->initial_error);
+    switch (request->operation)
+    {
+    case D3DM_REG_QUERY:
+        result.value = RegQueryValueExA(PTR(HKEY,0), PTR(LPCSTR,1), PTR(LPDWORD,2),
+                                       PTR(LPDWORD,3), PTR(BYTE *,4), PTR(LPDWORD,5));
+        break;
+    case D3DM_REG_SET:
+        result.value = RegSetValueExA(PTR(HKEY,0), PTR(LPCSTR,1), NUM(DWORD,2),
+                                     NUM(DWORD,3), PTR(const BYTE *,4), NUM(DWORD,5));
+        break;
+    case D3DM_REG_OPEN:
+        result.value = RegOpenKeyExA(PTR(HKEY,0), PTR(LPCSTR,1), NUM(DWORD,2), NUM(REGSAM,3), PTR(HKEY *,4));
+        break;
+    case D3DM_REG_CREATE:
+        result.value = RegCreateKeyExA(PTR(HKEY,0), PTR(LPCSTR,1), NUM(DWORD,2), PTR(LPSTR,3),
+                                      NUM(DWORD,4), NUM(REGSAM,5), PTR(LPSECURITY_ATTRIBUTES,6),
+                                      PTR(HKEY *,7), PTR(LPDWORD,8));
+        break;
+    case D3DM_REG_CLOSE:
+        result.value = RegCloseKey(PTR(HKEY,0));
+        break;
+    case D3DM_ENUM_MONITORS:
+    {
+        struct d3dmetal_monitor_context context = {PTR(MONITORENUMPROC,2), NUM(LPARAM,3)};
+        result.value = EnumDisplayMonitors(PTR(HDC,0), PTR(LPRECT,1), d3dmetal_monitor_relay, (LPARAM)&context);
+        break;
+    }
+    case D3DM_MONITOR_INFO:
+        result.value = GetMonitorInfoA(PTR(HMONITOR,0), PTR(LPMONITORINFO,1));
+        break;
+    case D3DM_ADJUST_RECT:
+        result.value = AdjustWindowRectEx(PTR(LPRECT,0), NUM(DWORD,1), NUM(BOOL,2), NUM(DWORD,3));
+        break;
+    case D3DM_GET_WINDOW_LONG:
+        result.value = GetWindowLongPtrW(PTR(HWND,0), NUM(INT,1));
+        break;
+    case D3DM_GET_WINDOW_RECT:
+        result.value = GetWindowRect(PTR(HWND,0), PTR(LPRECT,1));
+        break;
+    case D3DM_MOVE_WINDOW:
+        result.value = MoveWindow(PTR(HWND,0), NUM(INT,1), NUM(INT,2), NUM(INT,3), NUM(INT,4), NUM(BOOL,5));
+        break;
+    case D3DM_SET_WINDOW_POS:
+        result.value = SetWindowPos(PTR(HWND,0), PTR(HWND,1), NUM(INT,2), NUM(INT,3), NUM(INT,4), NUM(INT,5), NUM(UINT,6));
+        break;
+    case D3DM_GET_METRIC:
+        result.value = GetSystemMetrics(NUM(INT,0));
+        break;
+    case D3DM_SET_WINDOW_LONG:
+        result.value = SetWindowLongPtrW(PTR(HWND,0), NUM(INT,1), NUM(LONG_PTR,2));
+        break;
+    }
+
+    result.last_error = GetLastError();
+    return NtCallbackReturn(&result, sizeof(result), STATUS_SUCCESS);
+}
