@@ -0,0 +1,34 @@
+/* Original Caskrun Wine 11 host adapter. LGPL-2.1-or-later. */
+#include "config.h"
+#import <AppKit/AppKit.h>
+#import "cocoa_event.h"
+
+/* Retaining while holding the window-data lock is solely a lifetime operation;
+ * it never dispatches to the main thread. All view access and release happen
+ * after that lock has been released. */
+macdrv_window d3dmetal_macdrv_retain_window(macdrv_window window)
+{
+    return (macdrv_window)[(NSWindow *)window retain];
+}
+
+macdrv_view d3dmetal_macdrv_retain_view(macdrv_view view)
+{
+    return (macdrv_view)[(NSView *)view retain];
+}
+
+macdrv_view d3dmetal_macdrv_content_view(macdrv_window window)
+{
+    __block NSView *view = nil;
+    OnMainThread(^{ view = [[(NSWindow *)window contentView] retain]; });
+    return (macdrv_view)view;
+}
+
+void d3dmetal_macdrv_release_objects(macdrv_window window, macdrv_view view, macdrv_view client)
+{
+    OnMainThread(^{ [(NSView *)client release]; [(NSView *)view release]; [(NSWindow *)window release]; });
+}
+
+void d3dmetal_macdrv_main_thread(dispatch_block_t block)
+{
+    if (block) OnMainThread(block);
+}
