+/* Export data, not a function. No private Apple entrypoint is looked up or
+ * patched; this driver exposes only this published, typed host contract. */
+__attribute__((visibility("default"))) struct d3dmetal_macdrv_functions macdrv_functions =
+{
+    host_init_displays, host_get_window, host_release_window, macdrv_get_cocoa_window,
+    macdrv_create_metal_device, macdrv_release_metal_device, host_create_view, host_get_layer,
