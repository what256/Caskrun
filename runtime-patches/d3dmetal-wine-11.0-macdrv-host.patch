@@ -0,0 +1,443 @@
+/* Original Caskrun Wine 11 host adapter. LGPL-2.1-or-later.
+ * Public interface facts: Apple's game-porting-toolkit formula, revision
+ * 2bc44284e24d39ed64d6f492a0e1f4c47a5ced08, macdrv_functions declarations.
+ * This is an independent implementation against upstream Wine 11 APIs. */
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <dispatch/dispatch.h>
+#include "macdrv.h"
+#include "winreg.h"
+#include "winerror.h"
+#include "d3dmetal-macdrv.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+#ifdef __x86_64__
+#define D3DM_MSABI __attribute__((ms_abi))
+#define ARG(value) ((UINT64)(UINT_PTR)(value))
+
+extern macdrv_window d3dmetal_macdrv_retain_window(macdrv_window window);
+extern macdrv_view d3dmetal_macdrv_retain_view(macdrv_view view);
+extern macdrv_view d3dmetal_macdrv_content_view(macdrv_window window);
+extern void d3dmetal_macdrv_release_objects(macdrv_window window, macdrv_view view, macdrv_view client);
+extern void d3dmetal_macdrv_main_thread(dispatch_block_t block);
+extern UINT64 d3dmetal_macdrv_callback;
+
+/* A published historical ABI, never an alias for Wine 11's private structure.
+ * Deliberately explicit bit positions and padding make the wire layout stable. */
+struct d3dmetal_macdrv_window
+{
+    HWND hwnd;
+    macdrv_window cocoa_window;
+    macdrv_view cocoa_view;
+    macdrv_view client_cocoa_view;
+    RECT window_rect;
+    RECT whole_rect;
+    RECT client_rect;
+    int pixel_format;
+    COLORREF color_key;
+    HANDLE drag_event;
+    unsigned int flags;
+    unsigned int reserved;
+    void *padding[2];
+};
+
+C_ASSERT(sizeof(struct d3dmetal_macdrv_window) == 120);
+C_ASSERT(offsetof(struct d3dmetal_macdrv_window, client_cocoa_view) == 24);
+C_ASSERT(offsetof(struct d3dmetal_macdrv_window, window_rect) == 32);
+C_ASSERT(offsetof(struct d3dmetal_macdrv_window, pixel_format) == 80);
+C_ASSERT(offsetof(struct d3dmetal_macdrv_window, drag_event) == 88);
+C_ASSERT(offsetof(struct d3dmetal_macdrv_window, flags) == 96);
+C_ASSERT(offsetof(struct d3dmetal_macdrv_window, padding) == 104);
+
+struct d3dmetal_macdrv_context
+{
+    struct d3dmetal_macdrv_window snapshot;
+    struct d3dmetal_macdrv_context *next;
+    struct macdrv_client_surface *surface;
+    macdrv_metal_view metal_view;
+    unsigned int refs;
+    BOOL snapshot_owned;
+    BOOL view_owned;
+    unsigned int view_calls;
+    BOOL creating_view;
+};
+
+/* This lock protects only our adapter contexts and reference counts. Never
+ * hold it across a Wine window lock, a PE callback or a synchronous Cocoa call. */
+static pthread_mutex_t context_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct d3dmetal_macdrv_context *contexts;
+
+static void context_release(struct d3dmetal_macdrv_context *context)
+{
+    struct d3dmetal_macdrv_context **cursor;
+    BOOL destroy;
+
+    pthread_mutex_lock(&context_mutex);
+    destroy = !--context->refs;
+    if (destroy)
+    {
+        for (cursor = &contexts; *cursor != context; cursor = &(*cursor)->next) {}
+        *cursor = context->next;
+    }
+    pthread_mutex_unlock(&context_mutex);
+    if (!destroy) return;
+
+    /* Only this adapter's surface is released. Its existing Wine destructor
+     * owns the Metal view; releasing a view again here would double-free it. */
+    client_surface_release(&context->surface->client);
+    d3dmetal_macdrv_release_objects(context->snapshot.cocoa_window, context->snapshot.cocoa_view,
+                                     context->snapshot.client_cocoa_view);
+    free(context);
+}
+
+static struct d3dmetal_macdrv_window *host_get_window(HWND hwnd)
+{
+    struct d3dmetal_macdrv_context *context;
+    struct macdrv_win_data *data;
+
+    if (!hwnd || !(data = get_win_data(hwnd))) return NULL;
+    release_win_data(data);
+    if (!(context = calloc(1, sizeof(*context)))) return NULL;
+    if (!(context->surface = macdrv_client_surface_create(hwnd))) goto failed;
+    if (!(data = get_win_data(hwnd))) goto failed_surface;
+    if (!data->cocoa_window || !data->client_view || data->client_view != context->surface->cocoa_view)
+    {
+        release_win_data(data);
+        goto failed_surface;
+    }
+
+    context->snapshot.hwnd = data->hwnd;
+    context->snapshot.cocoa_window = d3dmetal_macdrv_retain_window(data->cocoa_window);
+    /* detach clears client_view under this same driver lock before disposing
+     * it. Matching and retaining that guarded pointer makes acquisition atomic
+     * with detach; never retain the surface's unguarded raw pointer. */
+    context->snapshot.client_cocoa_view = d3dmetal_macdrv_retain_view(data->client_view);
+    context->snapshot.window_rect = data->rects.window;
+    context->snapshot.whole_rect = data->rects.visible;
+    context->snapshot.client_rect = data->rects.client;
+    context->snapshot.pixel_format = data->pixel_format;
+    context->snapshot.drag_event = data->drag_event; /* Borrowed; never closed by this adapter. */
+    context->snapshot.flags = data->on_screen | data->shaped << 1 | data->layered << 2 |
+                              data->ulw_layered << 3 | data->per_pixel_alpha << 4 | data->minimized << 5;
+    release_win_data(data);
+
+    /* Read layered-window attributes through Wine rather than inventing a key.
+     * A non-layered window has no colour key and retains the zero initializer. */
+    NtUserGetLayeredWindowAttributes(hwnd, &context->snapshot.color_key, NULL, NULL);
+
+    /* No driver lock is held while Cocoa synchronizes with its main thread. */
+    context->snapshot.cocoa_view = d3dmetal_macdrv_content_view(context->snapshot.cocoa_window);
+    if (!context->snapshot.cocoa_view)
+    {
+        d3dmetal_macdrv_release_objects(context->snapshot.cocoa_window, NULL, context->snapshot.client_cocoa_view);
+        goto failed_surface;
+    }
+    context->refs = 1;
+    context->snapshot_owned = TRUE;
+    pthread_mutex_lock(&context_mutex);
+    context->next = contexts;
+    contexts = context;
+    pthread_mutex_unlock(&context_mutex);
+    return &context->snapshot;
+
+failed_surface:
+    client_surface_release(&context->surface->client);
+failed:
+    free(context);
+    return NULL;
+}
+
+static void host_release_window(struct d3dmetal_macdrv_window *snapshot)
+{
+    struct d3dmetal_macdrv_context *context;
+
+    pthread_mutex_lock(&context_mutex);
+    for (context = contexts; context; context = context->next)
+        if (&context->snapshot == snapshot && context->snapshot_owned) break;
+    if (context) context->snapshot_owned = FALSE;
+    pthread_mutex_unlock(&context_mutex);
+    if (context) context_release(context);
+}
+
+static BOOL context_is_attached(struct d3dmetal_macdrv_context *context)
+{
+    struct macdrv_win_data *data = get_win_data(context->snapshot.hwnd);
+    BOOL attached = data && data->client_view == context->snapshot.client_cocoa_view;
+    release_win_data(data);
+    return attached;
+}
+
+static macdrv_metal_view host_create_view(macdrv_view parent, macdrv_metal_device device)
+{
+    struct d3dmetal_macdrv_context *context;
+    macdrv_metal_view view;
+
+    if (!parent || !device) return NULL;
+    pthread_mutex_lock(&context_mutex);
+    for (context = contexts; context; context = context->next)
+        if (context->snapshot_owned && context->snapshot.client_cocoa_view == parent &&
+            !context->creating_view && !context->metal_view) break;
+    if (context)
+    {
+        context->refs++;
+        context->creating_view = TRUE;
+    }
+    pthread_mutex_unlock(&context_mutex);
+    /* Unknown or stale views are not ours and must never be attached/released. */
+    if (!context) return NULL;
+
+    if (!context_is_attached(context))
+    {
+        pthread_mutex_lock(&context_mutex);
+        context->creating_view = FALSE;
+        pthread_mutex_unlock(&context_mutex);
+        context_release(context);
+        return NULL;
+    }
+    view = macdrv_view_create_metal_view(parent, device);
+    if (view && !context_is_attached(context))
+    {
+        macdrv_view_release_metal_view(view);
+        view = NULL;
+    }
+    if (view)
+    {
+        context->surface->metal_view = view;
+        client_surface_update(&context->surface->client);
+        client_surface_present(&context->surface->client);
+    }
+    pthread_mutex_lock(&context_mutex);
+    context->creating_view = FALSE;
+    context->metal_view = view;
+    context->view_owned = !!view;
+    pthread_mutex_unlock(&context_mutex);
+    /* The successful create reference belongs to release_metal_view. */
+    if (!view) context_release(context);
+    return view;
+}
+
+/* Called only with our context mutex held. A release waits for any in-flight
+ * get_layer call before removing its actual view; the surface destructor must
+ * never release that view a second time. Clearing it also permits safe reuse
+ * of a still-owned snapshot after its previous view has been released. */
+static macdrv_metal_view take_released_view(struct d3dmetal_macdrv_context *context)
+{
+    macdrv_metal_view view;
+
+    if (context->view_owned || context->view_calls || !(view = context->metal_view)) return NULL;
+    context->metal_view = NULL;
+    context->surface->metal_view = NULL;
+    return view;
+}
+
+static macdrv_metal_layer host_get_layer(macdrv_metal_view view)
+{
+    struct d3dmetal_macdrv_context *context;
+    macdrv_metal_layer layer;
+    macdrv_metal_view released;
+
+    pthread_mutex_lock(&context_mutex);
+    for (context = contexts; context; context = context->next)
+        if (context->metal_view == view && context->view_owned) break;
+    if (context)
+    {
+        context->refs++;
+        context->view_calls++;
+    }
+    pthread_mutex_unlock(&context_mutex);
+    if (!context) return NULL;
+    layer = macdrv_view_get_metal_layer(view);
+    pthread_mutex_lock(&context_mutex);
+    context->view_calls--;
+    released = take_released_view(context);
+    pthread_mutex_unlock(&context_mutex);
+    if (released) macdrv_view_release_metal_view(released);
+    context_release(context);
+    return layer;
+}
+
+static void host_release_view(macdrv_metal_view view)
+{
+    struct d3dmetal_macdrv_context *context;
+    macdrv_metal_view released = NULL;
+
+    pthread_mutex_lock(&context_mutex);
+    for (context = contexts; context; context = context->next)
+        if (context->metal_view == view && context->view_owned) break;
+    if (context)
+    {
+        context->view_owned = FALSE;
+        released = take_released_view(context);
+    }
+    pthread_mutex_unlock(&context_mutex);
+    if (released) macdrv_view_release_metal_view(released);
+    if (context) context_release(context);
+}
+
+static UINT64 call_pe(UINT operation, const UINT64 args[9], UINT64 failure)
+{
+    struct d3dmetal_macdrv_request request = {.dispatch.callback = d3dmetal_macdrv_callback,
+                                             .operation = operation,
+                                             .initial_error = NtCurrentTeb()->LastErrorValue};
+    struct d3dmetal_macdrv_result result;
+    NTSTATUS status;
+    void *reply;
+    ULONG reply_size;
+
+    if (!request.dispatch.callback)
+    {
+        NtCurrentTeb()->LastErrorValue = ERROR_CALL_NOT_IMPLEMENTED;
+        return failure;
+    }
+    memcpy(request.args, args, sizeof(request.args));
+    status = KeUserDispatchCallback(&request.dispatch, sizeof(request), &reply, &reply_size);
+    if (status || reply_size != sizeof(result))
+    {
+        WARN("D3DMetal PE callback %u failed, status %#x\n", operation, status);
+        NtCurrentTeb()->LastErrorValue = ERROR_CALL_NOT_IMPLEMENTED;
+        return failure;
+    }
+    memcpy(&result, reply, sizeof(result));
+    NtCurrentTeb()->LastErrorValue = result.last_error;
+    return result.value;
+}
+
