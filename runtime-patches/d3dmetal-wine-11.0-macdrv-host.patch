+{
+    return call_pe(D3DM_REG_QUERY, (UINT64[9]){ARG(key),ARG(name),ARG(reserved),ARG(type),ARG(data),ARG(size)}, ERROR_CALL_NOT_IMPLEMENTED);
+}
