+typedef BOOL (D3DM_MSABI *host_monitor_callback)(HMONITOR, HDC, LPRECT, LPARAM);
+/* Entered only through Wine's normal Unix-call dispatcher from the PE relay.
+ * The callback therefore runs with native stack/TSD state and the published
+ * Microsoft ABI, and can call other host APIs synchronously. */
+NTSTATUS d3dmetal_macdrv_enum_callback(void *arg)
+{
+    struct d3dmetal_monitor_callback_params *params = arg;
+    host_monitor_callback callback = (void *)(UINT_PTR)params->callback;
+
+    if (!callback) return STATUS_INVALID_PARAMETER;
+    NtCurrentTeb()->LastErrorValue = params->last_error;
+    params->result = callback((HMONITOR)(UINT_PTR)params->monitor, (HDC)(UINT_PTR)params->dc,
+                              (LPRECT)(UINT_PTR)params->rect, (LPARAM)params->data);
+    params->last_error = NtCurrentTeb()->LastErrorValue;
+    return STATUS_SUCCESS;
+}
+
