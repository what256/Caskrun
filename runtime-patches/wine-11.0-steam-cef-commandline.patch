 static UINT process_error_mode;
 
+/* Caskrun's opt-in Steam compatibility flags belong to the web helper's
+ * Windows command line, not only the Unix loader argv. Steam replaces its
+ * own files during updates, so altering steamwebhelper.exe is not durable. */
+static BOOL caskrun_image_basename_is( const UNICODE_STRING *image, const char *basename )
+{
+    const WCHAR *start, *end, *cursor;
+    SIZE_T i, length;
+
+    if (!image || !image->Buffer || image->Length % sizeof(WCHAR)) return FALSE;
+    start = image->Buffer;
+    end = start + image->Length / sizeof(WCHAR);
+    for (cursor = start; cursor < end; cursor++)
+        if (*cursor == '\\' || *cursor == '/') start = cursor + 1;
+    length = end - start;
+    if (length != strlen( basename )) return FALSE;
+    for (i = 0; i < length; i++)
+    {
+        WCHAR c = start[i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c != basename[i]) return FALSE;
+    }
+    return TRUE;
+}
