+    - (BOOL) caskrunHandleTextContextEvent:(NSEvent*)event
+    {
+        WineWindow *window;
+        NSRect contentRect;
+        NSPoint point;
+        CGPoint targetPoint;
+        CGEventRef mouseEvent;
+        unsigned int i;
+        macdrv_query *query;
+        uint64_t now;
+
+        if (event.type == NSEventTypeRightMouseUp && caskrunConsumedRightButton)
+        {
+            caskrunConsumedRightButton = NO;
+            return YES;
+        }
+        if (event.type == NSEventTypeRightMouseDragged && caskrunConsumedRightButton) return YES;
+        if (event.type != NSEventTypeRightMouseDown)
+        {
+            /* Same-root focus can still change after Tab or another click. */
+            if (event.type == NSEventTypeKeyDown || event.type == NSEventTypeKeyUp ||
+                event.type == NSEventTypeFlagsChanged || event.type == NSEventTypeLeftMouseDown ||
+                event.type == NSEventTypeOtherMouseDown || event.type == NSEventTypeScrollWheel)
+                macdrv_cancel_native_text_context();
+            return NO;
+        }
+        /* NSMenu's modal tracker can consume the release itself. A fresh
+         * physical press starts a new pair and must not inherit that state. */
+        caskrunConsumedRightButton = NO;
+        macdrv_cancel_native_text_context();
+        if (!CaskrunSteamDockEnabled() || !CaskrunIsWindowsProcess(@"steamwebhelper.exe") ||
+            mouseCaptureWindow || self.clippingCursor || [windowsBeingDragged count] || !cursor ||
+            (cursor != [NSCursor IBeamCursor] && cursor != [NSCursor IBeamCursorForVerticalLayout])) return NO;
+        window = (WineWindow*)event.window;
+        if (![window isKindOfClass:[WineWindow class]] || window != NSApp.keyWindow ||
+            !window.isVisible || window.closing || window.disabled || window.noForeground) return NO;
+        contentRect = [window contentRectForFrameRect:window.frame];
+        point = [window convertPointToScreen:event.locationInWindow];
+        if (!NSPointInRect(point, contentRect)) return NO;
+
+        /* Let the Windows text surface target the field under this click
+         * before an edit action is queued. Pair it immediately: NSMenu can
+         * consume the physical release while tracking. Neither a dangling
+         * button nor editing the previously focused field is acceptable. */
+        mouseEvent = [event CGEvent];
+        if (!mouseEvent) return NO;
+        targetPoint = cgpoint_win_from_mac(CGEventGetLocation(mouseEvent));
+        now = CaskrunTextContextTime();
+        if (now > UINT64_MAX - 450 * 1000000 || !(query = CaskrunCreateTextContextQuery())) return NO;
+        /* Capacity is reserved before forwarding a click or changing focus. */
+        atomic_store(&caskrunTextContextDeadline, now + 450 * 1000000);
+        unmatchedMouseDowns &= ~NSEventMaskRightMouseDown;
+        for (i = 0; i < 2; i++)
+        {
+            macdrv_event *click = macdrv_create_event(MOUSE_BUTTON, window);
+            click->mouse_button.button = 1;
+            click->mouse_button.pressed = i == 0;
+            click->mouse_button.x = floor(targetPoint.x);
+            click->mouse_button.y = floor(targetPoint.y);
+            click->mouse_button.time_ms = [self ticksForEventTime:event.timestamp];
+            [window.queue postEvent:click];
+            macdrv_release_event(click);
+        }
+        forceNextMouseMoveAbsolute = TRUE;
+        caskrunConsumedRightButton = YES;
+        query->window = (macdrv_window)[window retain];
+        query->native_text_context.foreground = macdrv_get_window_hwnd((macdrv_window)[window ancestorWineWindow]);
+        query->native_text_context.serial = atomic_load(&caskrunTextContextSerial);
+        macdrv_event *request = macdrv_create_event(QUERY_EVENT_NO_PREEMPT_WAIT, window);
+        request->query_event.query = macdrv_retain_query(query);
+        [window.queue postEvent:request];
+        macdrv_release_event(request);
+        [self caskrunPrepareTextContextForWindow:window event:event
+                                        serial:atomic_load(&caskrunTextContextSerial)
+                                    foreground:macdrv_get_window_hwnd((macdrv_window)[window ancestorWineWindow])
+                                      menuSeen:NO query:query];
+        return YES; /* physical release is consumed after the balanced targeting pair */
+    }
