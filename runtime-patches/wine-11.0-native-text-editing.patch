+/* A canceled click must not dismiss a menu when its queued query finally runs. */
+static atomic_uint caskrunTextContextSerial;
+static atomic_uint_fast64_t caskrunTextContextDeadline;
+static atomic_uint caskrunTextContextPending;
+
+static uint64_t CaskrunTextContextTime(void)
+{
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now)) return UINT64_MAX;
+    return (uint64_t)now.tv_sec * 1000000000 + now.tv_nsec;
+}
+
+bool macdrv_native_text_context_current(unsigned int serial)
+{
+    return serial == atomic_load(&caskrunTextContextSerial) &&
+           CaskrunTextContextTime() < atomic_load(&caskrunTextContextDeadline);
+}
+
+void macdrv_cancel_native_text_context(void)
+{
+    atomic_fetch_add(&caskrunTextContextSerial, 1);
+    atomic_store(&caskrunTextContextDeadline, 0);
+}
+
+void macdrv_release_native_text_context_slot(void)
+{
+    atomic_fetch_sub(&caskrunTextContextPending, 1);
+}
+
+static macdrv_query *CaskrunCreateTextContextQuery(void)
+{
+    unsigned int pending = atomic_load(&caskrunTextContextPending);
+    macdrv_query *query;
+    do
+    {
+        if (pending >= 4) return NULL;
+    } while (!atomic_compare_exchange_weak(&caskrunTextContextPending, &pending, pending + 1));
+    query = macdrv_create_query();
+    if (!query) { macdrv_release_native_text_context_slot(); return NULL; }
+    query->type = QUERY_NATIVE_TEXT_CONTEXT;
+    query->native_text_context.slot_owned = true;
+    return query;
+}
+
+static void CaskrunCancelTextContext(unsigned int serial)
+{
+    /* An old timer must not invalidate a newer click. */
+    atomic_compare_exchange_strong(&caskrunTextContextSerial, &serial, serial + 1);
+}
