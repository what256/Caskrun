  *
  * Handler for HOTKEY_PRESS events.
  */
+/* Native menu actions carry keys only, never clipboard or field contents.
+ * Target the same Wine root that owned the Cocoa menu, so a delayed action
+ * cannot edit a newly focused Windows application.  Hardware inputs are
+ * explicitly addressed to that root and every modifier is restored. */
+void macdrv_native_text_edit(HWND hwnd, const macdrv_event *event)
+{
+    static const struct {
+        WORD vkey, scan;
+    } modifiers[] = {
+        { VK_LSHIFT, 0x2a }, { VK_RSHIFT, 0x136 }, /* server uses extended bit to select RSHIFT */
+        { VK_LCONTROL, 0x1d }, { VK_RCONTROL, 0x11d },
+        { VK_LMENU, 0x38 }, { VK_RMENU, 0x138 },
+        { VK_LWIN, 0x15b }, { VK_RWIN, 0x15c },
+    };
+    struct macdrv_thread_data *data = macdrv_thread_data();
+    GUITHREADINFO info = { .cbSize = sizeof(info) };
+    HWND root, foreground;
+    BYTE keystate[256];
+    WORD vkey = event->native_text_edit.vkey, scan = 0;
+    unsigned int i;
+    BOOL added_control;
+
+    if (vkey != 'A' && vkey != 'C' && vkey != 'V' && vkey != 'X') return;
+    if (event->native_text_edit.context_menu &&
+        (macdrv_queue_has_mouse_button_events(data->queue) ||
+         ((NtUserGetQueueStatus(QS_MOUSEBUTTON) >> 16) & QS_MOUSEBUTTON))) return;
+    if (!hwnd || !event->native_text_edit.foreground) return;
+    root = NtUserGetAncestor(hwnd, GA_ROOT);
+    foreground = NtUserGetForegroundWindow();
+    if (!root || root != foreground || foreground != event->native_text_edit.foreground) return;
+    if (!NtUserGetGUIThreadInfo(NtUserGetWindowThread(foreground, NULL), &info) ||
+        !info.hwndFocus || NtUserGetAncestor(info.hwndFocus, GA_ROOT) != root ||
+        (info.flags & (GUI_INMENUMODE | GUI_INMOVESIZE))) return;
+    if (!NtUserGetAsyncKeyboardState(keystate)) return;
+    if (keystate[vkey] & 0x80) return; /* do not release a physically held letter */
+    for (i = 0; i < ARRAY_SIZE(data->keyc2vkey); i++)
+        if (data->keyc2vkey[i] == vkey) { scan = data->keyc2scan[i]; break; }
+    if (!scan || root != NtUserGetForegroundWindow()) return;
+
+    for (i = 0; i < ARRAY_SIZE(modifiers); i++)
+        if (modifiers[i].vkey != VK_LCONTROL && modifiers[i].vkey != VK_RCONTROL &&
+            (keystate[modifiers[i].vkey] & 0x80))
+            macdrv_send_keyboard_input(root, modifiers[i].vkey, modifiers[i].scan & 0xff,
+                                       KEYEVENTF_KEYUP | ((modifiers[i].scan & 0x100) ? KEYEVENTF_EXTENDEDKEY : 0),
+                                       event->native_text_edit.time_ms);
+    added_control = !(keystate[VK_LCONTROL] & 0x80) && !(keystate[VK_RCONTROL] & 0x80);
+    if (added_control)
+        macdrv_send_keyboard_input(root, VK_LCONTROL, 0x1d, 0, event->native_text_edit.time_ms);
+    macdrv_send_keyboard_input(root, vkey, scan & 0xff, (scan & 0x100) ? KEYEVENTF_EXTENDEDKEY : 0,
+                               event->native_text_edit.time_ms);
+    macdrv_send_keyboard_input(root, vkey, scan & 0xff,
+                               KEYEVENTF_KEYUP | ((scan & 0x100) ? KEYEVENTF_EXTENDEDKEY : 0),
+                               event->native_text_edit.time_ms);
+    if (added_control)
+        macdrv_send_keyboard_input(root, VK_LCONTROL, 0x1d, KEYEVENTF_KEYUP,
+                                   event->native_text_edit.time_ms);
+    for (i = 0; i < ARRAY_SIZE(modifiers); i++)
+        if (modifiers[i].vkey != VK_LCONTROL && modifiers[i].vkey != VK_RCONTROL &&
+            (keystate[modifiers[i].vkey] & 0x80))
+            macdrv_send_keyboard_input(root, modifiers[i].vkey, modifiers[i].scan & 0xff,
+                                       (modifiers[i].scan & 0x100) ? KEYEVENTF_EXTENDEDKEY : 0,
+                                       event->native_text_edit.time_ms);
+}
