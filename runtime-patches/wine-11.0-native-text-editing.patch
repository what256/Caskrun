+    /* Never put a native popup over a still-tracking Windows popup. This is
+     * asynchronous: nested Windows menu tracking may need the Cocoa thread.
+     * Unknown/custom CEF menus remain the original single menu. */
+    - (void) caskrunPrepareTextContextForWindow:(WineWindow*)window event:(NSEvent*)mouseEvent
+                                       serial:(unsigned int)serial foreground:(void*)foreground menuSeen:(BOOL)menuSeen query:(macdrv_query*)query
+    {
+        unsigned int phase = NATIVE_TEXT_CONTEXT_PENDING;
+        BOOL valid = macdrv_native_text_context_current(serial) &&
+                     window == NSApp.keyWindow && window.isVisible && !window.closing &&
+                     !window.disabled && !window.noForeground && !self.clippingCursor &&
+                     ![windowsBeingDragged count] &&
+                     CaskrunSteamDockEnabled() && CaskrunIsWindowsProcess(@"steamwebhelper.exe");
+
+        if (!valid)
+        {
+            CaskrunCancelTextContext(serial);
+            if (query) macdrv_release_query(query);
+            return;
+        }
+        if (query && query->done)
+        {
+            phase = query->status ? query->native_text_context.phase : NATIVE_TEXT_CONTEXT_REFUSED;
+            macdrv_release_query(query);
+            query = NULL;
+            if (phase == NATIVE_TEXT_CONTEXT_REFUSED)
+            {
+                CaskrunCancelTextContext(serial);
+                return;
+            }
+            if (phase == NATIVE_TEXT_CONTEXT_DISMISS_REQUESTED) menuSeen = YES;
+            if (phase == NATIVE_TEXT_CONTEXT_READY)
+            {
+                if (menuSeen && !mouseCaptureWindow && macdrv_native_text_context_current(serial))
+                    [NSMenu popUpContextMenu:[self caskrunTextMenuForWindow:window]
+                                  withEvent:mouseEvent forView:window.contentView];
+                CaskrunCancelTextContext(serial);
+                return;
+            }
+        }
+        if (!query)
+        {
+            macdrv_event *event;
+            query = CaskrunCreateTextContextQuery();
+            if (!query) { CaskrunCancelTextContext(serial); return; }
+            query->window = (macdrv_window)[window retain];
+            query->native_text_context.foreground = foreground;
+            query->native_text_context.serial = serial;
+            query->native_text_context.menu_seen = menuSeen;
+            event = macdrv_create_event(QUERY_EVENT_NO_PREEMPT_WAIT, window);
+            event->query_event.query = macdrv_retain_query(query);
+            [window.queue postEvent:event];
+            macdrv_release_event(event);
+        }
+        /* The copied block retains only the original window and mouse event.
+         * One outstanding query per request; all terminal branches release it. */
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+            [self caskrunPrepareTextContextForWindow:window event:mouseEvent serial:serial foreground:foreground menuSeen:menuSeen query:query];
+        });
+    }
