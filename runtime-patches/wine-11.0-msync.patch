+const struct object_ops msync_ops = MSYNC_OBJECT_OPS( &event_type );
+static const struct object_ops msync_mutex_ops = MSYNC_OBJECT_OPS( &mutex_type );
+static const struct object_ops msync_semaphore_ops = MSYNC_OBJECT_OPS( &semaphore_type );
+#undef MSYNC_OBJECT_OPS
