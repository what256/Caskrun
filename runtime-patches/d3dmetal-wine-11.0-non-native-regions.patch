+/* Original Wine 11 adaptation of Apple's published non-native region API.
+ * The opt-in path is validated by the owning launcher. The library stays open
+ * for the process lifetime, as in Apple's public Homebrew formula. */
+#if defined(__APPLE__) && defined(__x86_64__)
+static void *d3dmetal_support_library;
+static void (*d3dmetal_register_region)(void *, void *);
+
+static void init_d3dmetal_support(void)
+{
+    const char *path = getenv( "CASKRUN_D3DMETAL_SHARED_LIBRARY" );
+    _Bool (*supports_regions)(void);
+    void (*register_region)(void *, void *);
+
+    if (!path || !path[0]) return;
+    if (path[0] != '/')
+    {
+        ERR( "D3DMetal support needs an absolute private library path\n" );
+        return;
+    }
+    d3dmetal_support_library = dlopen( path, RTLD_NOW | RTLD_LOCAL );
+    if (!d3dmetal_support_library)
+    {
+        ERR( "Could not load the private D3DMetal support library\n" );
+        return;
+    }
+    supports_regions = dlsym( d3dmetal_support_library, "supports_non_native_code_regions" );
+    register_region = dlsym( d3dmetal_support_library, "register_non_native_code_region" );
+    if (supports_regions && register_region && supports_regions())
+    {
+        d3dmetal_register_region = register_region;
+        TRACE( "Apple non-native region support enabled\n" );
+    }
+    else WARN( "Apple non-native region support is unavailable\n" );
+}
+#else
+static void init_d3dmetal_support(void) {}
+#endif
+
+static NTSTATUS register_non_native_region( void *args )
+{
+#if defined(__APPLE__) && defined(__x86_64__)
+    const struct register_non_native_region_params *params = args;
+    if (d3dmetal_register_region && params->start && params->size &&
+        (ULONG_PTR)params->start <= ~(ULONG_PTR)0 - params->size)
+    {
+        d3dmetal_register_region( params->start, (char *)params->start + params->size );
+        TRACE( "Application PE region registered with Apple support\n" );
+    }
+#endif
+    return STATUS_SUCCESS;
+}
+
 static const unixlib_entry_t unix_call_funcs[] =
 {
     load_so_dll,
