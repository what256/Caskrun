+/* Isolated Caskrun experiment. Select the native executable's basename per
+ * Windows process so a game launched from Steam does not inherit Steam's Dock
+ * identity. No Steam asset or CrossOver implementation is involved. */
+static BOOL caskrun_steam_dock_program( const char *command )
+{
+    const char *identity = getenv( "CASKRUN_STEAM_MODE" );
+    const char *name = command, *cursor;
+
+    if (!identity || strcmp( identity, "1" ) || !command) return FALSE;
+    for (cursor = command; *cursor; cursor++)
+        if (*cursor == '/' || *cursor == '\\') name = cursor + 1;
+    return !strcasecmp( name, "steam.exe" ) || !strcasecmp( name, "steamwebhelper.exe" );
+}
