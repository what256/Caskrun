+/* Caskrun's Steam-only Dock experiment. Match the Windows process image at
+ * argv[0], or argv[1] only when argv[0] is the native Wine loader. */
+static BOOL CaskrunSteamDockEnabled(void)
+{
+    const char *value = getenv("CASKRUN_STEAM_MODE");
+    return value && !strcmp(value, "1");
+}
+
+static NSString* CaskrunArgumentBasename(NSString *argument)
+{
+    return [[argument stringByReplacingOccurrencesOfString:@"\\" withString:@"/"] lastPathComponent];
+}
+
+static BOOL CaskrunIsWindowsProcess(NSString *expected)
+{
+    NSArray *arguments = [[NSProcessInfo processInfo] arguments];
+    NSString *first;
+
+    if (![arguments count]) return NO;
+    first = CaskrunArgumentBasename(arguments[0]);
+    if ([first caseInsensitiveCompare:expected] == NSOrderedSame) return YES;
+    if ([arguments count] < 2 ||
+        ([first caseInsensitiveCompare:@"Steam"] != NSOrderedSame &&
+         [first caseInsensitiveCompare:@"wine"] != NSOrderedSame)) return NO;
+    return [CaskrunArgumentBasename(arguments[1]) caseInsensitiveCompare:expected] == NSOrderedSame;
+}
+
+static NSImage* CaskrunSteamIcon(void)
+{
+    const char *raw = getenv("CASKRUN_STEAM_ICON");
+    struct stat info;
+    NSString *path;
+
+    if (!raw || *raw != '/' || lstat(raw, &info) || !S_ISREG(info.st_mode) ||
+        info.st_size <= 0 || info.st_size > 16 * 1024 * 1024) return nil;
+    if (!(path = [NSString stringWithUTF8String:raw])) return nil;
+    return [[[NSImage alloc] initWithContentsOfFile:path] autorelease];
 }
 
 
