--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -692,4 +692,25 @@
 
 #endif  /* defined(__i386__) || defined(__x86_64__) */
 
+/* Original Caskrun dual-ABI native import boundary. R10/R11 are volatile in
+ * both x64 ABIs and carry no NT API arguments. Tail jumps preserve the entire
+ * caller stack, integer/vector argument registers and nonvolatile state. */
+#if defined(__APPLE__) && defined(__x86_64__)
+#include "wine/asm.h"
+extern ULONG_PTR caskrun_d3dmetal_text_begin, caskrun_d3dmetal_text_end;
+#define CASKRUN_D3DMETAL_ABI_EXPORT(api, native_impl, apple_impl) \
+    asm( ".text\n\t.align 4\n\t.globl " __ASM_NAME(#api) "\n" \
+         __ASM_NAME(#api) ":\n\t" \
+         "movq " __ASM_NAME("caskrun_d3dmetal_text_begin") "(%rip), %r11\n\t" \
+         "testq %r11, %r11\n\t" \
+         "jz 1f\n\t" \
+         "movq (%rsp), %r10\n\t" \
+         "cmpq %r11, %r10\n\t" \
+         "jb 1f\n\t" \
+         "cmpq " __ASM_NAME("caskrun_d3dmetal_text_end") "(%rip), %r10\n\t" \
+         "jae 1f\n\t" \
+         "jmp " __ASM_NAME(#apple_impl) "\n" \
+         "1:\n\tjmp " __ASM_NAME(#native_impl) "\n" );
+#endif
+
 #endif /* __NTDLL_UNIX_PRIVATE_H */
