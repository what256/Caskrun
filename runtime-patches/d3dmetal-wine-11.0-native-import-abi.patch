@@ -1466,6 +1468,9 @@
     const char *path = getenv( "CASKRUN_D3DMETAL_SHARED_LIBRARY" );
     _Bool (*supports_regions)(void);
     void (*register_region)(void *, void *);
+    Dl_info library_info;
+    const uint8_t *text;
+    unsigned long text_size = 0;
 
     if (!path || !path[0]) return;
     if (path[0] != '/')
@@ -1483,6 +1488,17 @@
     register_region = dlsym( d3dmetal_support_library, "register_non_native_code_region" );
     if (supports_regions && register_region && supports_regions())
     {
+        /* Public dyld image metadata, not private framework state. Only this
+         * explicitly selected library may call Wine's native imports as MSABI. */
+        if (!dladdr( supports_regions, &library_info ) || !library_info.dli_fbase ||
+            !(text = getsegmentdata( library_info.dli_fbase, "__TEXT", &text_size )) ||
+            !text_size || (ULONG_PTR)text > ~(ULONG_PTR)0 - text_size)
+        {
+            WARN( "Apple support library has no valid executable image range\n" );
+            return;
+        }
+        caskrun_d3dmetal_text_begin = (ULONG_PTR)text;
+        caskrun_d3dmetal_text_end = (ULONG_PTR)text + text_size;
         d3dmetal_register_region = register_region;
         TRACE( "Apple non-native region support enabled\n" );
     }
