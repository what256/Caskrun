+/* Button gestures belong to the view that accepted their down. AppKit may
+ * consume the physical up in its tracking loop; the next fresh down clears a
+ * stale gesture for that button. Retaining only the window avoids event/CF
+ * ownership and allows releases outside the header to stay off the Wine queue. */
+@interface CaskrunSteamHeaderMouseRouter : NSObject
+{
+    NSMutableDictionary *owners;
+}
+- (NSWindow *)windowForEvent:(NSEvent *)event beginWindow:(NSWindow *)window;
+- (void)cancel;
+- (void)forgetWindow:(NSWindow *)window;
+@end
+@implementation CaskrunSteamHeaderMouseRouter
+- (id)init
+{
+    if ((self = [super init])) owners = [[NSMutableDictionary alloc] init];
+    return self;
+}
+- (void)dealloc { [owners release]; [super dealloc]; }
+- (void)cancel { [owners removeAllObjects]; }
+- (void)forgetWindow:(NSWindow *)window
+{
+    for (NSNumber *key in [owners allKeys])
+        if ([owners objectForKey:key] == window) [owners removeObjectForKey:key];
+}
+- (NSWindow *)windowForEvent:(NSEvent *)event beginWindow:(NSWindow *)window
+{
+    NSEventType type = event.type;
+    BOOL down = type == NSEventTypeLeftMouseDown || type == NSEventTypeRightMouseDown || type == NSEventTypeOtherMouseDown;
+    BOOL up = type == NSEventTypeLeftMouseUp || type == NSEventTypeRightMouseUp || type == NSEventTypeOtherMouseUp;
+    BOOL drag = type == NSEventTypeLeftMouseDragged || type == NSEventTypeRightMouseDragged || type == NSEventTypeOtherMouseDragged;
+    if (down || up || drag)
+    {
+        NSNumber *key = @(event.buttonNumber);
+        NSWindow *owner;
+        if (down)
+        {
+            [owners removeObjectForKey:key];
+            if (window) [owners setObject:window forKey:key];
+            return window;
+        }
+        owner = [[[owners objectForKey:key] retain] autorelease];
+        if (up) [owners removeObjectForKey:key];
+        return owner;
+    }
+    return (type == NSEventTypeMouseMoved || type == NSEventTypeScrollWheel) ? window : nil;
+}
