+/* Original Caskrun opt-in native identity. The launcher supplies a verified
+ * core/runtime and canonical data home. Each Windows child supplies its own
+ * resolved image; a parent's application label is never reused. */
+static BOOL caskrun_native_identity_enabled(void)
+{
+#ifdef __APPLE__
+    const char *core = getenv( "CASKRUN_NATIVE_CORE" );
+    const char *home = getenv( "CASKRUN_NATIVE_DATA" );
+    const char *image = getenv( "CASKRUN_NATIVE_IMAGE" );
+    const char *bottle = getenv( "CASKRUN_NATIVE_BOTTLE" );
+    const char *ntdll = getenv( "CASKRUN_NATIVE_NTDLL" );
+    return core && *core == '/' && home && *home == '/' && image && *image == '/' &&
+           bottle && *bottle && ntdll && *ntdll == '/';
+#else
+    return FALSE;
+#endif
+}
+
+#ifdef __APPLE__
+static BOOL caskrun_native_owned_file( const char *path, BOOL executable )
+{
+    struct stat info;
+    char resolved[PATH_MAX];
+
+    return path && *path == '/' && !lstat( path, &info ) && S_ISREG( info.st_mode ) &&
+           (info.st_uid == geteuid() || info.st_uid == 0) && !(info.st_mode & 0022) &&
+           realpath( path, resolved ) && !strcmp( path, resolved ) &&
+           (!executable || !access( path, X_OK ));
+}
+
+static BOOL caskrun_native_bottle_id( const char *value )
+{
+    unsigned int i;
+
+    if (strlen( value ) != 36) return FALSE;
+    for (i = 0; i < 36; i++)
+    {
+        if (i == 8 || i == 13 || i == 18 || i == 23)
+        {
+            if (value[i] != '-') return FALSE;
+        }
+        else if (!(value[i] >= '0' && value[i] <= '9') &&
+                 !(value[i] >= 'a' && value[i] <= 'f')) return FALSE;
+    }
+    return TRUE;
+}
+
+static LONGLONG caskrun_native_milliseconds(void)
+{
+    struct timespec now;
+    if (clock_gettime( CLOCK_MONOTONIC, &now )) return -1;
+    return (LONGLONG)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
