+/* A native identity belongs to this Windows image, not its launcher. The
+ * generated .app's Info.plist overrides the loader's neutral embedded plist. */
+static BOOL CaskrunNativeDockEnabled(void)
+{
+    const char *value = getenv("CASKRUN_NATIVE_EXEC");
+    return value && !strcmp(value, "1");
+}
+
+static NSString* CaskrunNativeImageName(void)
+{
+    const char *image = getenv("CASKRUN_NATIVE_IMAGE");
+    NSString *path;
+    if (!image || !(path = [NSString stringWithUTF8String:image])) return nil;
+    return [CaskrunArgumentBasename(path) lowercaseString];
+}
+
+static BOOL CaskrunNativeBackgroundProcess(void)
+{
+    NSString *name = CaskrunNativeImageName();
+    NSArray *arguments = [[NSProcessInfo processInfo] arguments];
+    NSString *role = nil;
+    NSUInteger i;
+
+    if ([name isEqualToString:@"services.exe"] || [name isEqualToString:@"winedevice.exe"] ||
+        [name isEqualToString:@"plugplay.exe"] || [name isEqualToString:@"rpcss.exe"] ||
+        [name isEqualToString:@"ctfmon.exe"]) return YES;
+    /* Electron can use the same executable for its browser and subprocesses.
+     * Only explicit, known Chromium roles suppress a Dock item; the basename
+     * never decides whether an ordinary app or its browser is background.
+     * Match both switch forms, stopping at the positional separator. The last
+     * type switch controls classification, so a browser override stays visible. */
+    for (i = 0; i < [arguments count]; i++)
+    {
+        NSString *argument = arguments[i];
+        if ([argument isEqualToString:@"--"]) break;
+        if ([argument hasPrefix:@"--type="])
+            role = [argument substringFromIndex:7];
+        else if ([argument isEqualToString:@"--type"])
+            role = i + 1 < [arguments count] ? arguments[++i] : @"";
+    }
+    return [role isEqualToString:@"renderer"] || [role isEqualToString:@"gpu-process"] ||
+           [role isEqualToString:@"utility"] || [role isEqualToString:@"zygote"] ||
+           [role isEqualToString:@"crashpad-handler"];
+}
+
+static NSImage* CaskrunNativeIcon(void)
+{
+    NSBundle *bundle = [NSBundle mainBundle];
+    NSString *path = [bundle pathForResource:@"app" ofType:@"icns"];
+    if (!path) path = [bundle pathForResource:@"app" ofType:@"ico"];
+    struct stat info;
+    const char *raw = [path fileSystemRepresentation];
+
+    if (!raw || lstat(raw, &info) || !S_ISREG(info.st_mode) ||
+        info.st_size <= 0 || info.st_size > 16 * 1024 * 1024) return nil;
+    return [[[NSImage alloc] initWithContentsOfFile:path] autorelease];
+}
