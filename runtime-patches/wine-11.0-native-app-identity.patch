+/* A generated native app copies the signed generic Wine loader away from
+ * ntdll.so. Caskrun supplies the selected independent runtime's canonical
+ * library path. Do not resolve a relative path or follow a replacement link. */
+static void *caskrun_native_dlopen(void)
+{
+#ifdef __APPLE__
+    const char *path = getenv( "CASKRUN_NATIVE_NTDLL" );
+    const char *enabled = getenv( "CASKRUN_NATIVE_EXEC" );
+    struct stat info;
+    char resolved[PATH_MAX];
+
+    if (!enabled || strcmp( enabled, "1" ) || !path || *path != '/' ||
+        lstat( path, &info ) || !S_ISREG( info.st_mode ) ||
+        (info.st_uid != geteuid() && info.st_uid != 0) || (info.st_mode & 0022) ||
+        !realpath( path, resolved ) || strcmp( path, resolved )) return NULL;
+    return dlopen( path, RTLD_NOW );
+#else
+    return NULL;
+#endif
+}
