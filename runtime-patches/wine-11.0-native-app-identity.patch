+    if (!caskrun_native_identity_enabled() || !caskrun_native_bottle_id( bottle ) ||
+        !caskrun_native_owned_file( core, TRUE ) || !caskrun_native_owned_file( ntdll, FALSE ) ||
+        lstat( home, &info ) || !S_ISDIR( info.st_mode ) || info.st_uid != geteuid() ||
+        (info.st_mode & 0022) || !realpath( home, resolved ) || strcmp( home, resolved )) return NULL;
+    expected = build_path( ntdll_dir, "ntdll.so" );
+    error = strcmp( ntdll, expected );
+    free( expected );
+    if (error || (deadline = caskrun_native_milliseconds()) < 0) return NULL;
+    deadline += 2000;
+
+    for (count = 0; environ[count]; count++) ;
+    if (!(helper_env = calloc( count + 2, sizeof(*helper_env) )) ||
+        asprintf( &home_env, "CASKRUN_HOME=%s", home ) < 0) goto done;
+    for (count = i = 0; environ[i]; i++)
+    {
+        if (!strncmp( environ[i], "CASKRUN_HOME=", 13 ) ||
+            !strncmp( environ[i], "WINESERVERSOCKET=", 17 ) ||
+            !strncmp( environ[i], "WINELOADERNOEXEC=", 17 ) ||
+            !strncmp( environ[i], "WINEPRELOADRESERVE=", 19 ) ||
+            !strncmp( environ[i], "CASKRUN_NATIVE_EXEC=", 20 )) continue;
