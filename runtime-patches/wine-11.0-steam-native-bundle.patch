+static char *caskrun_native_steam_app_program( char **argv )
+{
+    const char *command = argv[2];
+    const char *app = getenv( "CASKRUN_STEAM_NATIVE_APP" );
+    const char *home = getenv( "CASKRUN_NATIVE_DATA" );
+    const char *bottle = getenv( "CASKRUN_NATIVE_BOTTLE" );
+    const char *image = getenv( "CASKRUN_NATIVE_IMAGE" );
+    const char *core = getenv( "CASKRUN_NATIVE_CORE" );
+    const char *ntdll = getenv( "CASKRUN_NATIVE_NTDLL" );
+    const char *name = command, *cursor, *component, *slash;
+    static const char suffix[] = "/Contents/MacOS/WindowsApp";
+    char prefix[PATH_MAX], cache[PATH_MAX], directory[PATH_MAX], resolved_image[PATH_MAX], *expected;
+    size_t i, length, home_length;
+    BOOL selected;
+
+    if (!command || !caskrun_steam_dock_program( command )) return NULL;
+    for (cursor = command; *cursor; cursor++)
+        if (*cursor == '/' || *cursor == '\\') name = cursor + 1;
+    if (strcasecmp( name, "steamwebhelper.exe" ) || caskrun_steam_background_process( argv ) ||
+        !caskrun_native_identity_enabled() ||
+        !caskrun_native_bottle_id( bottle ) || !app || strlen( app ) >= sizeof(directory) ||
+        !caskrun_native_owned_file( core, TRUE ) || !caskrun_native_owned_file( ntdll, FALSE ) ||
+        !realpath( image, resolved_image ) || !caskrun_native_owned_file( resolved_image, FALSE ) ||
+        !caskrun_native_owned_file( app, TRUE ) ||
+        !caskrun_native_steam_directory( home )) return NULL;
+    expected = build_path( ntdll_dir, "ntdll.so" );
+    selected = !strcmp( ntdll, expected );
+    free( expected );
+    if (!selected) return NULL;
+
+    length = snprintf( prefix, sizeof(prefix), "%s/bottles/%s/prefix/", home, bottle );
+    /* Wine reports ordinary DOS images through prefix/dosdevices/c:. Resolve
+     * only that image path; both forms must remain in this private prefix.
+     * Alias, Core, NTDLL and cache ancestor canonical checks stay unchanged. */
+    if (length >= sizeof(prefix) || strncmp( image, prefix, length ) ||
+        strncmp( resolved_image, prefix, length )) return NULL;
+    name = strrchr( resolved_image, '/' );
