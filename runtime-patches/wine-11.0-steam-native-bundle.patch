+              (component[i] >= 'a' && component[i] <= 'f'))) return NULL;
+    if (component[64] != '/') return NULL;
+    component += 65;
+    if (!(slash = strchr( component, '/' )) || strcmp( slash, suffix )) return NULL;
+    length = slash - component;
+    if (length <= 4 || length > 324 || memcmp( slash - 4, ".app", 4 ) ||
+        component[0] == '.' || component[0] == ' ' ||
+        slash[-5] == '.' || slash[-5] == ' ') return NULL;
+    for (i = 0; i < length; i++)
+        if ((unsigned char)component[i] < 32 || component[i] == 127 ||
+            component[i] == '\\' || component[i] == ':') return NULL;
