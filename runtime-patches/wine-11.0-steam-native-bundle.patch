+    while ((cursor = strrchr( directory, '/' )) && (size_t)(cursor - directory) >= home_length)
+    {
+        directory[cursor - directory] = 0;
+        if (!caskrun_native_steam_directory( directory )) return NULL;
+        if (strlen( directory ) == home_length) break;
+    }
+    return strdup( app );
 }
 
