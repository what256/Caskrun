+/* Steam's UI helper reuses the bundle Core validated before launching the
+ * client. Never call Core from this child startup path, and never carry the
+ * client's native identity into a game. Older/unrecognized bundles retain
+ * the original Steam loader. */
+static BOOL caskrun_native_steam_directory( const char *path )
+{
+    struct stat info;
+    char resolved[PATH_MAX];
+
+    return !lstat( path, &info ) && S_ISDIR( info.st_mode ) &&
+           info.st_uid == geteuid() && !(info.st_mode & 0022) &&
+           realpath( path, resolved ) && !strcmp( path, resolved );
+}
+
+/* Only explicit Chromium subprocess roles share the accessory raw loader.
+ * Steam's browser has no type switch, and an unknown role stays eligible for
+ * the prepared UI bundle. Keep this parser in sync with the Cocoa classifier:
+ * both switch forms, the final switch wins, and -- ends option processing. */
+static BOOL caskrun_steam_background_process( char **argv )
+{
+    const char *role = NULL;
+    size_t i;
+
+    for (i = 3; argv[i]; i++)
+    {
+        if (!strcmp( argv[i], "--" )) break;
+        if (!strncmp( argv[i], "--type=", 7 )) role = argv[i] + 7;
+        else if (!strcmp( argv[i], "--type" ))
+        {
+            if (!argv[i + 1]) { role = ""; break; }
+            role = argv[++i];
+        }
+    }
+    return role && (!strcmp( role, "renderer" ) || !strcmp( role, "gpu-process" ) ||
+                    !strcmp( role, "utility" ) || !strcmp( role, "zygote" ) ||
+                    !strcmp( role, "crashpad-handler" ));
+}
