@end
@implementation WineEventQueue
-(id)init{self=[super init];if(self){events=[NSMutableArray new];eventsLock=[NSLock new];}return self;}
-(void)fixtureAddType:(int)type{MacDrvEvent *queued=[MacDrvEvent new];queued->event=calloc(1,sizeof(*queued->event));queued->event->type=type;[events addObject:queued];}
-(NSUInteger)fixtureEventCount{return events.count;}
-(void)fixtureClear{for(MacDrvEvent *queued in events) free(queued->event);[events removeAllObjects];}
@@QUEUE_PEEK@@
-(void)postEvent:(macdrv_event*)event{if(event->type==MOUSE_BUTTON){assert(button_count<2);assert(event->mouse_button.button==1);assert(event->mouse_button.x==140&&event->mouse_button.y==80);buttons[button_count++]=event->mouse_button.pressed;if(event->mouse_button.pressed)field_focus=event->mouse_button.x>=100?2:1;return;}assert(event->type==33);assert(event->native_text_edit.foreground==(void*)321);last_action=event->native_text_edit.vkey;action_focus=field_focus;posted++;}
@end
