 method_exchangeImplementations(class_getClassMethod([NSCursor class],@selector(IBeamCursorForVerticalLayout)),class_getClassMethod([NSCursor class],@selector(fixtureVertical)));
 method_exchangeImplementations(class_getClassMethod([NSCursor class],@selector(arrowCursor)),class_getClassMethod([NSCursor class],@selector(fixtureArrow)));
 method_exchangeImplementations(class_getClassMethod([NSCursor class],@selector(pointingHandCursor)),class_getClassMethod([NSCursor class],@selector(fixtureHand)));
 method_exchangeImplementations(class_getClassMethod([NSMenu class],@selector(popUpContextMenu:withEvent:forView:)),class_getClassMethod([NSMenu class],@selector(fixturePopup:withEvent:forView:)));
 WineEventQueue *peek=[WineEventQueue new];assert(![peek hasMouseButtonEvents]);[peek fixtureAddType:6];assert(![peek hasMouseButtonEvents]);[peek fixtureAddType:10];for(int i=0;i<512;i++) assert([peek hasMouseButtonEvents]);assert(peek.fixtureEventCount==2);[peek fixtureClear];assert(![peek hasMouseButtonEvents]);
 testApp=[TestApplication new];WineWindow *window=[WineWindow new];window.visible=YES;window.frame=NSMakeRect(0,0,240,160);window.queue=[WineEventQueue new];testApp.keyWindow=window;
 WineApplicationController *controller=[WineApplicationController new];controller->windowsBeingDragged=[NSMutableSet new];controller->cursor=[NSCursor IBeamCursor];steam_enabled=helper_process=YES;
 controller->unmatchedMouseDowns=NSEventMaskRightMouseDown;field_focus=1;
 assert([controller caskrunHandleTextContextEvent:event(NSEventTypeRightMouseDown,window,140)]);
 assert(!controller->unmatchedMouseDowns);assert(popup_count==1 && button_count==2 && buttons[0] && !buttons[1]);assert(field_focus==2);
 assert(capturedMenu.numberOfItems==5);
 NSMenuItem *paste=capturedMenu.itemArray[2];assert([paste.title isEqualToString:@"Paste"]);assert(paste.tag=='V');assert([paste.keyEquivalent isEqualToString:@"v"]);assert(paste.keyEquivalentModifierMask==NSEventModifierFlagCommand);
 [controller caskrunNativeTextEdit:paste];assert(posted==1&&last_action=='V'&&action_focus==2);
 assert([controller caskrunHandleTextContextEvent:event(NSEventTypeRightMouseDragged,window,140)]);
 assert([controller caskrunHandleTextContextEvent:event(NSEventTypeRightMouseUp,window,140)]);assert(!controller->caskrunConsumedRightButton);assert(button_count==2);
 assert(![controller caskrunHandleTextContextEvent:event(NSEventTypeRightMouseUp,window,140)]);
 /* A menu tracker-consumed release cannot poison the next normal press. */
 controller->caskrunConsumedRightButton=YES;controller->cursor=[NSCursor arrowCursor];
 assert(![controller caskrunHandleTextContextEvent:event(NSEventTypeRightMouseDown,window,140)]);assert(!controller->caskrunConsumedRightButton);
 controller->cursor=[NSCursor IBeamCursor];
 for(int i=0;i<11;i++){
  missing_event=NO;steam_enabled=helper_process=YES;controller->mouseCaptureWindow=nil;controller->clippingCursor=NO;[controller->windowsBeingDragged removeAllObjects];controller->cursor=[NSCursor IBeamCursor];window.visible=YES;window.closing=window.disabled=window.noForeground=NO;testApp.keyWindow=window;
  switch(i){case 0:steam_enabled=NO;break;case 1:helper_process=NO;break;case 2:controller->mouseCaptureWindow=window;break;case 3:controller->clippingCursor=YES;break;case 4:[controller->windowsBeingDragged addObject:@1];break;case 5:controller->cursor=[NSCursor pointingHandCursor];break;case 6:window.closing=YES;break;case 7:window.visible=NO;break;case 8:testApp.keyWindow=nil;break;case 9:controller->cursor=nil;break;case 10:missing_event=YES;break;}
  assert(![controller caskrunHandleTextContextEvent:event(NSEventTypeRightMouseDown,window,140)]);assert(popup_count==1);
 }
 missing_event=NO;testApp.keyWindow=window;window.visible=YES;window.closing=NO;controller->cursor=[NSCursor IBeamCursor];controller->clippingCursor=NO;
 assert(![controller caskrunHandleTextContextEvent:event(NSEventTypeRightMouseDown,window,300)]);assert(popup_count==1);
 window.closing=YES;[controller caskrunNativeTextEdit:paste];assert(posted==1);
 window.closing=NO;testApp.keyWindow=nil;[controller caskrunNativeTextEdit:paste];assert(posted==1);
 puts("queue peek preserves events");
 puts("two-field targeting, native menu, paired releases and 14 context/action refusals passed");
