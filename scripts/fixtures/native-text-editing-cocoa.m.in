  missing_event=NO;steam_enabled=helper_process=YES;controller->mouseCaptureWindow=nil;controller->clippingCursor=NO;[controller->windowsBeingDragged removeAllObjects];controller->cursor=[NSCursor IBeamCursor];window.visible=YES;window.closing=window.disabled=window.noForeground=NO;testApp.keyWindow=window;
  switch(i){case 0:steam_enabled=NO;break;case 1:helper_process=NO;break;case 2:controller->mouseCaptureWindow=window;break;case 3:controller->clippingCursor=YES;break;case 4:[controller->windowsBeingDragged addObject:@1];break;case 5:controller->cursor=[NSCursor pointingHandCursor];break;case 6:window.closing=YES;break;case 7:window.visible=NO;break;case 8:testApp.keyWindow=nil;break;case 9:controller->cursor=nil;break;case 10:missing_event=YES;break;}
  assert(![controller caskrunHandleTextContextEvent:event(NSEventTypeRightMouseDown,window,140)]);assert(popup_count==1);
 }
 missing_event=NO;testApp.keyWindow=window;window.visible=YES;window.closing=NO;controller->cursor=[NSCursor IBeamCursor];controller->clippingCursor=NO;
 assert(![controller caskrunHandleTextContextEvent:event(NSEventTypeRightMouseDown,window,300)]);assert(popup_count==1);
 window.closing=YES;[controller caskrunNativeTextEdit:paste];assert(posted==1);
 window.closing=NO;testApp.keyWindow=nil;[controller caskrunNativeTextEdit:paste];assert(posted==1);

 /* Unsupported/custom popup: wait boundedly, leave the original alone. */
 testApp.keyWindow=window;query_mode=1;button_count=0;
 assert([controller caskrunHandleTextContextEvent:event(NSEventTypeRightMouseDown,window,140)]);
