  if(i==0)window.closing=YES;else testApp.keyWindow=nil;fixtureStep();assert(query_refs==0&&popup_count==1);window.closing=NO;testApp.keyWindow=window;
 }
 assert(!scheduled.count);puts("async menu exit, unsupported popup, timeout and same-root input cancellation passed");
 puts("queue peek preserves events");
