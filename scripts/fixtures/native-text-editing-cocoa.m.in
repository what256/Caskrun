static macdrv_query *late_queries[4];
static unsigned int late_count;
static macdrv_query *macdrv_create_query(void){macdrv_query*q=calloc(1,sizeof(*q));q->refs=1;query_refs++;return q;}
static macdrv_query *macdrv_retain_query(macdrv_query*q){q->refs++;return q;}
static void macdrv_release_query(macdrv_query*q){if(--q->refs==0){if(q->native_text_context.slot_owned)macdrv_release_native_text_context_slot();[(id)q->window release];free(q);query_refs--;}}
