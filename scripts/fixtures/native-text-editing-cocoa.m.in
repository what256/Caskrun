 testApp=[TestApplication new];WineWindow *window=[WineWindow new];window.visible=YES;window.frame=NSMakeRect(0,0,240,160);window.queue=[WineEventQueue new];testApp.keyWindow=window;
 WineApplicationController *controller=[WineApplicationController new];controller->windowsBeingDragged=[NSMutableSet new];controller->cursor=[NSCursor IBeamCursor];steam_enabled=helper_process=YES;
 controller->unmatchedMouseDowns=NSEventMaskRightMouseDown;field_focus=1;
