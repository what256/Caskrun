 method_exchangeImplementations(class_getClassMethod([NSCursor class],@selector(arrowCursor)),class_getClassMethod([NSCursor class],@selector(fixtureArrow)));
 method_exchangeImplementations(class_getClassMethod([NSCursor class],@selector(pointingHandCursor)),class_getClassMethod([NSCursor class],@selector(fixtureHand)));
