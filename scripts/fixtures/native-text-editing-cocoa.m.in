-(void)fixtureClear;
-(void)postEvent:(macdrv_event*)event;
@end
@implementation WineEventQueue
-(id)init{self=[super init];if(self){events=[NSMutableArray new];eventsLock=[NSLock new];}return self;}
-(void)fixtureAddType:(int)type{MacDrvEvent *queued=[MacDrvEvent new];queued->event=calloc(1,sizeof(*queued->event));queued->event->type=type;[events addObject:queued];}
-(NSUInteger)fixtureEventCount{return events.count;}
-(void)fixtureClear{for(MacDrvEvent *queued in events) free(queued->event);[events removeAllObjects];}
@@QUEUE_PEEK@@
-(void)postEvent:(macdrv_event*)event{
 if(event->type==QUERY_EVENT_NO_PREEMPT_WAIT){
  macdrv_query*q=event->query_event.query;assert(q->type==8&&q->native_text_context.foreground==(void*)321);query_count++;
  q->status=true;q->done=true;
  if(query_mode==1)q->native_text_context.phase=NATIVE_TEXT_CONTEXT_PENDING;
  else if(query_mode==2)q->native_text_context.phase=NATIVE_TEXT_CONTEXT_REFUSED;
  else if(query_mode==3){assert(late_count<4);late_queries[late_count++]=macdrv_retain_query(q);q->done=false;}
  else if(!q->native_text_context.menu_seen){assert(windows_popup);windows_popup=0;q->native_text_context.phase=NATIVE_TEXT_CONTEXT_DISMISS_REQUESTED;}
  else {assert(!windows_popup);q->native_text_context.phase=NATIVE_TEXT_CONTEXT_READY;}
  return;
 }
 if(event->type==MOUSE_BUTTON){assert(button_count<2);assert(event->mouse_button.button==1);assert(event->mouse_button.x==140&&event->mouse_button.y==80);buttons[button_count++]=event->mouse_button.pressed;if(event->mouse_button.pressed)field_focus=event->mouse_button.x>=100?2:1;else windows_popup=1;return;}assert(event->type==33);assert(event->native_text_edit.foreground==(void*)321);last_action=event->native_text_edit.vkey;action_focus=field_focus;posted++;}
@end
