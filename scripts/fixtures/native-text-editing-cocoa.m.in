 assert(!controller->unmatchedMouseDowns);assert(popup_count==0 && button_count==2 && buttons[0] && !buttons[1]);assert(field_focus==2);
 assert(query_count==2&&!windows_popup&&query_refs==1);fixtureStep();assert(popup_count==1&&query_refs==0&&atomic_load(&caskrunTextContextPending)==0);
 assert(capturedMenu.numberOfItems==5);
 NSMenuItem *paste=capturedMenu.itemArray[2];assert([paste.title isEqualToString:@"Paste"]);assert(paste.tag=='V');assert([paste.keyEquivalent isEqualToString:@"v"]);assert(paste.keyEquivalentModifierMask==NSEventModifierFlagCommand);
 [controller caskrunNativeTextEdit:paste];assert(posted==1&&last_action=='V'&&action_focus==2);
