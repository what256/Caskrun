 while(late_count){macdrv_query*q=late_queries[--late_count];assert(!macdrv_native_text_context_current(q->native_text_context.serial));macdrv_release_query(q);}
 assert(query_refs==0&&atomic_load(&caskrunTextContextPending)==0);
 missing_clock=YES;button_count=0;assert(![controller caskrunHandleTextContextEvent:event(NSEventTypeRightMouseDown,window,140)]);assert(button_count==0&&atomic_load(&caskrunTextContextPending)==0);missing_clock=NO;
 query_mode=1;
