* text=auto
*.sh text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.swift text eol=lf
*.md text eol=lf
# Unified diffs mark empty context lines with one space, including at EOF.
*.patch whitespace=-blank-at-eol,-blank-at-eof
*.png binary
# Preserve the upstream license's original blank-line whitespace.
runtime-patches/licenses/COPYING.LIB whitespace=-blank-at-eol
