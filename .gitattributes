* text=auto
*.sh text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.swift text eol=lf
*.md text eol=lf
# Unified diffs mark an empty context line with a single space.
*.patch whitespace=-blank-at-eol
*.png binary
# Preserve the upstream license's original blank-line whitespace.
runtime-patches/licenses/COPYING.LIB whitespace=-blank-at-eol
