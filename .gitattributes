* text=auto
*.sh text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.swift text eol=lf
*.md text eol=lf
# Unified diffs prefix context with one space, including Makefile tab indents.
*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
*.png binary
# Preserve the upstream license's original blank-line whitespace.
runtime-patches/licenses/COPYING.LIB whitespace=-blank-at-eol
